---
// Scorecard (design/lore/Scorecard.dc.html): grades the frozen baseline against results.
import ChampIcon from '../components/ChampIcon.astro';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { ratings } from '../lib/data';
import { crystal, dcgi, results, series, type Series } from '../lib/data';
import { pct, num } from '../lib/format';
import { grade, pickemPoints, stamp, started } from '../lib/grading';
import { startNz } from '../lib/stage';
import { url } from '../lib/url';

const pair = (x: { team_a?: string; team_b?: string }) => [x.team_a, x.team_b].sort().join('|');
const hiLo = (a: unknown, b: unknown) => `${Math.max(Number(a), Number(b))}-${Math.min(Number(a), Number(b))}`;
const short = (s?: string | null) => { const m = /(\d\d\/\d\d)\/\d{4} (\d\d:\d\d)/.exec(s || ''); return m ? `${m[1]} ${m[2]}` : 'UNKNOWN'; };

const g = grade().find((x) => x.set === 'baseline');
const n = g?.n ?? 0;
const done = results().filter((r) => r.kind !== 'swiss_record' && r.winner);

// Series table: every baseline call for the phases that have results so far (or the first phase before any result).
const base = series().filter((s) => s.set === 'baseline' && !s.actual && s.p_winner != null).sort((a, b) => (stamp(a.time_nz) ?? '9').localeCompare(stamp(b.time_nz) ?? '9'));
const phases = [...new Set(done.map((r) => r.phase))];
if (!phases.length && base[0]) phases.push(base[0].phase);
type Row = { s: Series; result: string; resCls: string; w: string; wCls: string; sc: string; scCls: string };
const rows: Row[] = base.filter((s) => phases.includes(s.phase)).map((s) => {
  const r = done.find((x) => x.id === s.id);
  // Round 2 onwards of the Play-In: the model's assumed pairing until the bracket settles it
  const call = { s, result: started(s) ? 'Pending' : 'To play', resCls: 'dim', w: '', wCls: '', sc: '', scCls: '' };
  if (!r) return call;
  if (pair(r) !== pair(s)) return { ...call, result: 'Not this pairing' };
  const result = `${r.winner} ${hiLo(r.score_a, r.score_b)}`;
  const made = stamp(s.created_nz), start = stamp(r.start_nz);
  if (made && start && made >= start) return { ...call, result, resCls: '', w: 'INVALID - post-start', wCls: 'risk' };
  const hit = s.winner === r.winner;
  const exact = hit && hiLo(r.score_a, r.score_b) === s.score;
  return { s, result, resCls: '', w: hit ? 'Right' : 'Wrong', wCls: hit ? 'teal' : 'risk', sc: exact ? 'Right' : 'Missed', scCls: exact ? 'teal' : 'muted' };
});
const graded = rows.filter((r) => r.sc);
const last = graded[graded.length - 1];
const exactSub = !last ? 'No series graded yet' : `${n > 1 ? 'Latest: called' : 'Called'} ${last.s.score}, it went ${last.result.split(' ').pop()}`;

// Pick'Ems: the latest stage with points decided, else the first stage
const pts = pickemPoints();
const pk = [...pts].reverse().find((p) => p.possible > 0) ?? pts[0];
const COIN = Math.LN2;
const tiles = [
  { k: 'Winners called', v: `${g?.correct ?? 0} / ${n}`, sub: 'Series graded so far', c: '' },
  { k: 'Exact scores', v: `${g?.exact ?? 0} / ${n}`, sub: exactSub, c: '' },
  { k: 'Log loss', v: num(g?.logloss, 2), sub: `Coin flip ${num(COIN, 2)}, lower is better`, c: 'gold' },
  { k: "Pick'Ems points", v: pk ? String(pk.earned) : 'UNKNOWN', sub: pk ? (pk.max == null ? `${pk.stage}: points per slot not published yet` : `of ${pk.max} in the ${pk.stage}`) : "Pick'Ems not available yet", c: '' },
];

const TIERS = [['LOCK', '75% and up', 'lock'], ['LEAN', '60 to 74%', 'lean'], ['COIN FLIP', 'Below 60%', 'coin']].map(([name, range, cls]) => {
  const t = g?.byTier[name];
  return { name, range, cls, rec: `${t?.hit ?? 0} / ${t?.n ?? 0}`, pct: t?.n ? pct(t.hit / t.n) : 'N/A' };
});

const dc = dcgi().find((r) => r.kind === 'summary') as Record<string, number> | undefined;
const accessed = done.map((r) => (r as { source?: { accessed?: string } }).source?.accessed).filter(Boolean).pop();
const cb = crystal();
// Crystal Ball answers get their art: champion tiles (art/tile) or icons, team logos, the lane icon for a role
const codes = new Set(ratings().map((r) => r.code));
const tileOf = (name: string) => existsSync(resolve(process.cwd(), 'public', 'art', 'tile', `${name}.jpg`)) ? url(`art/tile/${name}.jpg`) : null;
const roleOf = (a: string) => /^(Top|Jungle|Mid|Bot|Support)\b/.exec(a)?.[1];
const CONF: Record<string, string> = { HIGH: 'lock', MEDIUM: 'lean', LOW: 'coin' };
---
<Base title="Scorecard" active="scorecard" description="How the Worlds 2026 picks are doing: winners, exact scores, log loss, Pick'Ems points and the Crystal Ball."
  footer={{ left: `Results: gol.gg, accessed ${accessed ?? 'UNKNOWN'}. Log loss: lower is better, a coin flip scores ${num(COIN, 3)}.` }}>
  <section class="intro">
    <span class="eyebrow">Graded against results, updated as series finish</span>
    <h1>How the prophet is doing</h1>
    <p class="lede">Every call was made before the series started and is never edited. A call made after the start would be marked invalid.</p>
  </section>

  <section class="stat-strip" style="--n:4" aria-label="Summary">
    {tiles.map((t) => <div><span class="k">{t.k}</span><span class:list={['v', t.c]}>{t.v}</span><span class="sub">{t.sub}</span></div>)}
  </section>

  <section class="sc-grid">
    <div class="section">
      <div class="section-head"><h2>Series</h2><span>{phases.join(' and ')} so far</span></div>
      {rows.length ? (
        <div class="stable">
          <div class="srow shead"><span>Start</span><span>Series</span><span>Our call</span><span>Result</span><span>Winner</span><span>Score</span></div>
          <div class="rows">
            {rows.map((r) => (
              <div class="srow">
                <span class="title"><Logo code={r.s.team_a} size={26} /><span class="code">{r.s.team_a} v {r.s.team_b}</span>{!r.result.includes('-') && /predicted pairing/i.test(r.s.stage) && <span class="assumed">assumed pairing</span>}</span>
                <span class="meta"><span class="when muted2">{short(startNz(r.s))}</span><span class="ph">, called </span><span class="call">{r.s.winner} {pct(r.s.p_winner)}<span class="dt">, {r.s.score}</span></span></span>
                <span class:list={['res', r.resCls]}>{r.result}</span>
                <span class:list={['w', r.wCls]}>{r.w === 'Right' && <img class="poro" src={url('art/poro/main-256.png')} alt="" width="22" height="22" />}{r.w === 'Wrong' && <img class="poro" src={url('art/poro/dopey-256.png')} alt="" width="22" height="22" />}{r.w}</span>
                <span class:list={['sc', r.scCls]}>{r.sc}</span>
              </div>
            ))}
          </div>
        </div>
      ) : <p class="caption">No baseline calls to show yet.</p>}
    </div>

    <aside class="side">
      <div class="section tiers">
        <div class="section-head"><h2>By confidence tier</h2></div>
        <div class="rows">
          {TIERS.map((t) => (
            <div class="trow">
              <span class="tn"><span class:list={['tname', 'tier', t.cls]}>{t.name}</span><span class="caption">{t.range}</span></span>
              <span class="fg2">{t.rec}</span>
              <span class="big tp">{t.pct}</span>
            </div>
          ))}
        </div>
        <span class="caption">Tiers rate the winner only, never the score.</span>
      </div>
      {dc && (
        <a class="callout" href={url('demacia-cup/')}>
          <span class="eyebrow">Warm-up: Demacia Cup check</span>
          <span class="ctext">{dc.hits ?? 'UNKNOWN'} of {dc.n ?? 'UNKNOWN'} winners right, log loss {num(dc.logloss, 2)} against {num(dc.logloss_region_rule, 2)} for the region rule.</span>
          <span class="eyebrow">See the check →</span>
        </a>
      )}
    </aside>
  </section>

  {cb.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Crystal Ball</h2><span>Our answers, entered before the Play-In lock</span></div>
      <div class="rows">
        {cb.map((c) => (
          <div class="qrow">
            <span class="dim num">{c.q}</span>
            <span class="fg2">{c.question}</span>
            <span class="ans"><span class="code aart">{[1, 2, 3].includes(c.q) && c.answer
              ? (tileOf(c.answer) ? <><img class="tile" src={tileOf(c.answer)} alt="" width="36" height="36" />{c.answer}</> : <ChampIcon name={c.answer} size={28} />)
              : codes.has(c.answer) ? <><Logo code={c.answer} size={26} />{c.answer}</>
              : roleOf(c.answer) ? <Icon name={roleOf(c.answer)!} size={24} label={c.answer} />
              : (c.answer || 'UNKNOWN')}</span><span class:list={['tier', CONF[c.confidence] ?? 'coin']}>{c.confidence || 'UNKNOWN'}</span></span>
            <span class="caption why">{c.reason}</span>
          </div>
        ))}
      </div>
    </section>
  )}
</Base>
<style>
  .sc-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--space-xl); align-items: start; }
  .side { display: flex; flex-direction: column; gap: var(--space-lg); min-width: 0; }
  /* the series list lays itself out by its own width (it shares the row with the sidebar from 1151px) */
  .stable { container-type: inline-size; min-width: 0; }
  .srow { display: grid; grid-template-columns: 110px minmax(0, 1fr) 140px 130px 90px 90px; gap: var(--space-sm); align-items: center; min-height: 26px; }
  .shead { font-size: var(--fs-sm); color: var(--muted); padding-bottom: var(--space-2xs); }
  .when { order: -1; }
  .title { display: flex; align-items: center; flex-wrap: wrap; gap: 0 var(--space-2xs); min-width: 0; }
  .assumed { font-size: var(--fs-xs); color: var(--muted); }
  .meta { display: contents; }
  .ph { display: none; }
  .w, .sc { font-weight: 600; }
  .trow { display: grid; grid-template-columns: minmax(0, 1fr) auto 72px; gap: var(--space-sm); align-items: baseline; }
  .tn { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .tname { font-size: var(--fs-md); }
  .tp { font-size: var(--fs-xl); text-align: right; }
  .qrow { display: grid; grid-template-columns: 40px minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-3xs) var(--space-md); align-items: baseline; }
  .ans { display: flex; align-items: center; gap: var(--space-xs); flex-wrap: wrap; }
  .why { grid-column: 2 / -1; }
  @media (max-width: 1150px) { .sc-grid { grid-template-columns: minmax(0, 1fr); } }
  /* two-line rows whenever the six columns would squeeze the Series column (phones, tablets, the two-column laptop band) */
  @container (max-width: 860px) {
    .shead { display: none; }
    .srow { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "title w" "meta res"; gap: var(--space-3xs) var(--space-xs); }
    .title { grid-area: title; }
    .w { grid-area: w; text-align: right; }
    .res { grid-area: res; text-align: right; font-size: var(--fs-sm); color: var(--fg2); }
    .res.dim { color: var(--muted); }
    .meta { display: block; grid-area: meta; font-size: var(--fs-sm); color: var(--muted); }
    .when { color: var(--muted); }
    .ph { display: inline; } .dt { display: none; }
    .sc { display: none; }
  }
  @media (max-width: 640px) {
    .intro .eyebrow, .intro .lede { display: none; }
    .title :global(.logo), .title :global(.disc) { display: none; }
    .qrow { grid-template-columns: 28px minmax(0, 1fr); }
    .ans { grid-column: 2; }
    .why { display: none; }
  }
  .w { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .poro { border-radius: 50%; flex: none; }
  .aart { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .tile { border-radius: var(--radius-sm); object-fit: cover; object-position: center 20%; flex: none; }
</style>
