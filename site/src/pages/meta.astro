---
// Meta (design/lore/Meta.dc.html): the Worlds patch, draft rules, the 3-0 note, contested champions, Pick'Ems points and locks.
import ChampIcon from '../components/ChampIcon.astro';
import Icon from '../components/Icon.astro';
import art from '../lib/art.json';
import { url } from '../lib/url';
import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { metaChamps, overview, patchChanges } from '../lib/data';
import { nextLock } from '../lib/nav';

const ov = overview();
const changes = patchChanges();
const patch = changes.map((r) => r.patch).filter(Boolean).sort((a, b) => a.localeCompare(b, 'en', { numeric: true })).pop();
const cur = changes.filter((c) => c.patch === patch);
const nChamps = cur.filter((c) => c.kind === 'champion').length;
const nItems = cur.filter((c) => c.kind === 'item').length;
const names = (dir: string) => cur.filter((c) => c.kind === 'champion' && c.change === dir).map((c) => c.name);
const down = names('nerf'), up = names('buff');
const items = cur.filter((c) => c.kind === 'item').map((c) => ({ name: c.name, change: c.change }));

// Draft rules from overview.draft_modes, without the trailing source note
const draft = (ov.draft_modes ?? '').replace(/\s*\([^()]*\.md\)\s*$/, '').replace(/\.?$/, '.');

// Sweep check (model/sweep_check.py output): 2026 international Bo5s predicted walk-forward
const SWEEP = resolve(process.cwd(), '..', 'data', 'sweep_check.json');
const sw = existsSync(SWEEP) ? (JSON.parse(readFileSync(SWEEP, 'utf8')) as { rows: { sa: number; sb: number }[] }).rows : [];
const sweepPct = sw.length ? `${Math.round((100 * sw.filter((r) => Math.min(r.sa, r.sb) === 0).length) / sw.length)}%` : 'UNKNOWN';
const nBo5 = sw.length || 'UNKNOWN';

// splash art (art/splash/<Riot id>.jpg) for the champions the cache holds
const splashOf = (name: string) => {
  const f = (art as Record<string, string>)[name.toLowerCase().replace(/[^a-z]/g, '')];
  const id = f?.replace(/\.png$/, '');
  return id && existsSync(resolve(process.cwd(), 'public', 'art', 'splash', `${id}.jpg`)) ? url(`art/splash/${id}.jpg`) : null;
};
// roles text "Mid 18 / Bot 7" -> [{ role, n }]
const rolesOf = (t: string) => String(t || '').split('/').map((x) => x.trim()).filter(Boolean).map((x) => { const m = /^(\D+?)\s*(\d+)?$/.exec(x); return { role: m?.[1] ?? x, n: m?.[2] ?? '' }; });
const all = metaChamps();
const champs = [...all].sort((a, b) => a.rank - b.rank).slice(0, 12);
const p0 = (v: number | null | undefined) => (v == null ? 'UNKNOWN' : `${Math.round(v)}%`);
// Patch flag: the champion's latest change in patch_changes.json (the export's patch_note covers only a few champions)
const VERB: Record<string, string> = { nerf: 'Nerfed', buff: 'Buffed', adjust: 'Adjusted' };
const latest = new Map<string, string>();
for (const c of [...changes].filter((x) => x.kind === 'champion').sort((a, b) => b.patch.localeCompare(a.patch, 'en', { numeric: true }))) {
  if (!latest.has(c.name)) latest.set(c.name, `${VERB[c.change] ?? 'Changed'} ${c.patch}`);
}
const note = (c: { champion: string; patch_note: string }) => latest.get(c.champion) || c.patch_note || 'Unchanged';
const flag = (n: string) => (n.startsWith('Nerf') ? 'risk' : n.startsWith('Buff') ? 'teal' : n === 'Unchanged' ? 'dim' : 'muted2');
// Sample size: presence = (picks + bans) / games, so games = (picks + bans) / presence
const games = (() => { const t = champs[0]; return t && t.presence ? Math.round(((t.picks + t.bans) / t.presence) * 100) : null; })();

// Pick'Ems rows: points text per stage from overview.pickems_points, lock from overview.locks_nz
const STAGES = ['Play-In', 'Swiss', 'Knockouts'];
const segment = (text: string, stage: string) => {
  const m = new RegExp(`${stage}\\s+(.+?)(?:\\.\\s|$)`).exec(text);
  return m ? m[1].replace(/\s*=\s*(\d+)$/, '. $1 total') : 'UNKNOWN';
};
const lockOf = (stage: string) => (ov.locks_nz ?? '').split(';').find((p) => p.includes(stage))?.match(/(\d\d)\/(\d\d)\/(\d{4}) (\d\d):(\d\d)/);
const next = nextLock();
const stages = STAGES.map((name) => {
  const m = lockOf(name);
  if (!m) return { name, points: segment(ov.pickems_points ?? '', name), lock: 'Lock UNKNOWN', cls: 'dim' };
  const passed = Date.now() >= Date.UTC(+m[3], +m[2] - 1, +m[1], +m[4] - 13, +m[5]);
  const when = `${m[1]}/${m[2]} ${m[4]}:${m[5]} NZDT`;
  return { name, points: segment(ov.pickems_points ?? '', name), lock: `${passed ? 'Locked' : 'Locks'} ${when}`, cls: passed ? 'dim' : next?.date === `${m[1]}/${m[2]}/${m[3]}` ? 'gold' : 'fg2' };
});
---
<Base title="Meta" active="meta" description={`The Worlds 2026 patch ${patch ?? ''}: what changed, the most contested champions, draft rules and Pick'Ems points.`}
  footer={{ left: `Champion presence: gol.gg, most recent domestic playoffs; patch notes: leagueoflegends.com. Exported ${ov.exported_nz ?? 'UNKNOWN'}.`, right: 'A fan project. Champion names belong to Riot Games.' }}>
  <section class="intro">
    <span class="eyebrow">Patch {patch ?? 'UNKNOWN'}, the Worlds patch</span>
    <h1>The meta and the rules</h1>
    <p class="lede">What changed, which champions dominate drafts, and how the format shapes the scores.</p>
  </section>

  <section class="trio">
    <div class="panel box">
      <span class="eyebrow">Patch {patch ?? 'UNKNOWN'}</span>
      <p class="big-p">{cur.length ? `${nChamps} champions and ${nItems} items changed.` : 'Patch changes not available yet.'}</p>
      <div class="dirs">
        {down.length > 0 && <div class="dir"><span class="risk b">Down</span><span class="chl">{down.map((n) => <ChampIcon name={n} size={22} />)}</span></div>}
        {up.length > 0 && <div class="dir"><span class="teal b">Up</span><span class="chl">{up.map((n) => <ChampIcon name={n} size={22} />)}</span></div>}
        {items.length > 0 && <div class="dir"><span class="muted b">Items</span><span class="chl">{items.map((it) => <Icon name={it.name} size={22} label={it.name} />)}</span></div>}
      </div>
    </div>
    <div class="panel box draft">
      <span class="eyebrow">Draft</span>
      <p class="big-p">{draft || 'UNKNOWN'}</p>
    </div>
    <div class="callout box">
      <span class="eyebrow">Why so many 3-0 calls</span>
      <p class="big-p">Of {nBo5} Bo5s in 2026, {sweepPct} were sweeps, and 3-0 was the most common score at every favourite strength except true coin flips. A 3-0 call is the single likeliest score, not a promise.</p>
    </div>
  </section>

  {champs.some((c) => splashOf(c.champion)) && (
    <section class="splashes" aria-label="The most contested champions">
      {champs.slice(0, 3).map((c) => {
        const img = splashOf(c.champion);
        return (
          <article class="splash" style={img ? `--img:url(${img})` : undefined}>
            <span class="srk">#{c.rank} most contested</span>
            <span class="code sname">{c.champion}</span>
            <span class="sline"><span class="big">{p0(c.presence)}</span> <span class="fg2">presence</span></span>
            <span class:list={['pf2', flag(note(c))]}>{note(c)}</span>
          </article>
        );
      })}
    </section>
  )}

  <section class="section">
    <div class="section-head"><h2>Most contested champions</h2><span>Presence = picked or banned, in the {games ?? 'UNKNOWN'} games of the most recent domestic playoffs (gol.gg), top {champs.length}</span></div>
    {champs.length ? (
      <div>
        <div class="crow chead"><span><span class="sr-only">Rank</span></span><span>Champion</span><span>Roles</span><span>Presence</span><span class="r">Picks</span><span class="r">Win rate</span><span>Patch</span></div>
        <div class="rows crows">
          {champs.map((c) => (
            <div class="crow">
              <span class="rk dim">{c.rank}</span>
              <span class="nm"><span class="code"><ChampIcon name={c.champion} size={32} /></span><span class:list={['pf', flag(note(c))]}>{note(c)}</span></span>
              <span class="roles muted2">{c.roles ? rolesOf(c.roles).map((x) => <Icon name={x.role} size={20} label={x.n ? `${x.role} ${x.n}` : x.role} />) : 'UNKNOWN'}</span>
              <span class="pres"><span class="bar"><i style={`width:${c.presence ?? 0}%`}></i></span><span class="pv">{p0(c.presence)}</span></span>
              <span class="r pk">{c.picks ?? 'UNKNOWN'}</span>
              <span class="r wr">{p0(c.pick_wr)}</span>
              <span class:list={['flag', flag(note(c))]}>{note(c)}</span>
            </div>
          ))}
        </div>
      </div>
    ) : <p class="caption">Champion presence not available yet.</p>}
  </section>

  <section class="section">
    <div class="section-head"><h2>Pick'Ems points and locks</h2></div>
    <div class="rows prows">
      {stages.map((s) => (
        <div class="prow">
          <span class="code">{s.name}</span>
          <span class="fg2">{s.points}</span>
          <span class:list={['lk', s.cls]}>{s.lock}</span>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .trio { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: var(--space-md); }
  .box { display: flex; flex-direction: column; gap: var(--space-xs); }
  .dirs { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .b { font-weight: 600; min-width: 4.5em; }
  .dir { display: flex; gap: var(--space-sm); align-items: flex-start; }
  .chl { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-sm); font-size: var(--fs-sm); }
  .roles { display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-sm); font-size: var(--fs-sm); }
  /* top three as splash cards: the art fills the card, a gradient keeps the text readable */
  .splashes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }
  .splash { position: relative; min-height: 260px; border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-3xs); padding: var(--space-md); background: var(--surface) var(--img, none) center 25% / cover no-repeat; box-shadow: var(--inset); }
  .splash::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--bg) 8%, rgba(21, 17, 42, 0.55) 55%, rgba(21, 17, 42, 0.05)); }
  .splash > * { position: relative; }
  .srk { font-size: var(--fs-sm); color: var(--gold); font-weight: 600; }
  .sname { font-size: var(--fs-2xl); line-height: 1.05; }
  .sline .big { font-size: var(--fs-xl); }
  .pf2 { font-size: var(--fs-sm); font-weight: 600; }
  .crow { display: grid; grid-template-columns: 40px 200px 220px minmax(0, 1fr) 90px 90px 150px; gap: var(--space-md); align-items: center; }
  .chead { font-size: var(--fs-sm); color: var(--muted); padding-bottom: var(--space-2xs); }
  .r { text-align: right; }
  /* flex, not inline: an inline icon sits on the text strut and rides above the row's centre line */
  .nm, .nm .code { display: flex; align-items: center; min-width: 0; }
  .nm .pf { display: none; }
  .pres { display: flex; align-items: center; gap: var(--space-sm); min-width: 0; }
  .pres .bar { flex: 1; }
  .pv { width: 4ch; text-align: right; }
  .flag { font-weight: 600; }
  .prow { display: grid; grid-template-columns: 200px minmax(0, 1fr) 260px; gap: var(--space-md); align-items: baseline; }
  .lk { text-align: right; }
  @media (max-width: 1150px) {
    .crow { grid-template-columns: 32px 160px minmax(0, 1fr) 70px 80px 130px; }
    .roles { display: none; }
    .chead > span:nth-child(3) { display: none; }
  }
  /* below 760px the fixed columns would squeeze the presence bar away: two-column rows */
  @media (max-width: 900px) { .splashes { grid-template-columns: minmax(0, 1fr); } .splash { min-height: 180px; } }
  @media (max-width: 760px) {
    .chead { display: none; }
    .crow { grid-template-columns: 160px minmax(0, 1fr); gap: var(--space-xs); }
    .rk, .pk, .wr, .flag { display: none; }
    .nm { flex-direction: column; align-items: flex-start; gap: var(--space-3xs); }
    /* the patch flag lines up under the name, past the 32px icon and its 8px gap */
    .nm .pf { display: block; font-size: var(--fs-sm); padding-left: calc(32px + var(--space-2xs)); }
    .prow { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name lock" "pts pts"; gap: var(--space-3xs) var(--space-xs); }
    .prow > .code { grid-area: name; } .prow > .fg2 { grid-area: pts; } .prow > .lk { grid-area: lock; }
  }
  @media (max-width: 640px) {
    /* the h1 stays for screen readers (Phone Pages.dc.html has no visible intro here) */
    .intro { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .intro > :not(h1) { display: none; }
    .draft { display: none; }
    .box { gap: var(--space-2xs); }
    .trio > .panel .big-p { display: none; }
    .crow { grid-template-columns: 136px minmax(0, 1fr); }
    .nm .code { font-size: var(--fs-sm); }
    .nm :global(.champ img) { width: 24px; height: 24px; }
    .nm .pf { font-size: var(--fs-xs); padding-left: calc(24px + var(--space-2xs)); }
  }
</style>
