---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import NextUp from '../components/NextUp.astro';
import OddsList from '../components/OddsList.astro';
import { live, overview } from '../lib/data';
import { grade, nzToday, pickemPoints, today } from '../lib/grading';
import { liveStage } from '../lib/nav';
import { url } from '../lib/url';

const o = overview();
const lv = live();
const todays = today();
const stage = liveStage();
const STAGE_NAME: Record<string, string> = { 'play-in': 'Play-In', swiss: 'Swiss', knockouts: 'Knockouts' };
const rec = grade().find((g) => g.set === 'baseline');
const pts = pickemPoints().find((p) => p.stage === STAGE_NAME[stage]);
const lock = o.next_lock ?? '';
const lm = /(\d\d\/\d\d)\/\d{4} (\d\d:\d\d)/.exec(lock);
const lockAt = lm ? `${lm[1]} ${lm[2]}` : undefined; // dd/mm hh:mm fits the stat column; the caption carries the full date
const [ver, ...verRest] = (o.model_version ?? 'UNKNOWN').split(':');
const stats: [string, string][] = [
  [rec ? `${rec.correct} / ${rec.n}` : '0 / 0', rec?.n ? 'Winners called right by the frozen baseline.' : 'Winners called right. No results entered yet.'],
  [pts ? `${pts.earned} / ${pts.max ?? 'UNKNOWN'}` : 'UNKNOWN', pts ? `Pick'Ems points, ${STAGE_NAME[stage]}, ${pts.possible} decided so far.` : `${STAGE_NAME[stage]} Pick'Ems not available yet.`],
  [lockAt ?? 'UNKNOWN', lock ? `${lock}.` : 'Next lock not available yet.'],
  [ver, `Model, ${verRest.join(':').trim() || 'UNKNOWN'}. Ratings as of ${lv[0]?.as_of ?? 'UNKNOWN'}.`],
];
---
<Base title="Home" active="home">
  <header class="page-head home-head">
    <div class="page-head">
      <p class="wordmark">Poro Prophet</p>
      <p class="caption">Picks for every Worlds 2026 series, live title odds and how the frozen baseline is doing. Times NZDT with the venue time alongside.</p>
    </div>
    <img class="poro" src={url('art/poro/main-512.webp')} width="72" height="72" alt="The Poro Prophet" />
  </header>

  <section class="panel">
    <p class="caption">{todays.length ? `Today, ${nzToday()}, NZDT.` : 'Next up, the next open series.'}</p>
    <NextUp rows={todays.length ? todays : undefined} hero />
    <a class="more" href={url(`${stage}/`)}>Full bracket and picks</a>
  </section>

  <div class="grid-2">
    <Card title="Title odds" note={`Live, refitted ${lv[0]?.generated_nz ?? 'UNKNOWN'} after every result so far. The frozen picks never change.`}>
      <OddsList rows={lv.map((x) => ({ code: x.team, p: x.p_champion }))} top={10} />
      <a class="more" href={url('teams/')}>All 19 teams</a>
    </Card>
    <section class="section" aria-label="How the model is doing">
      <div class="grid-4 stats">
        {stats.map(([v, c]) => <div class="stat"><b class:list={[{ muted: v === 'UNKNOWN' }]}>{v}</b><span>{c}</span></div>)}
      </div>
    </section>
  </div>
<script is:inline src={url('js/clock.js')} defer></script>
</Base>
<style>
  .home-head { flex-direction: row; justify-content: space-between; align-items: flex-start; gap: var(--space-md); }
  .wordmark { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); line-height: 1.1; letter-spacing: -0.02em; }
  .poro { width: var(--space-2xl); height: var(--space-2xl); border-radius: var(--radius-panel); flex: none; }
  .more { color: var(--color-ink-2); font-size: var(--text-sm); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: var(--space-3xs); align-self: flex-start; }
  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-lg); }
  @media (max-width: 640px) { .poro { width: var(--space-xl); height: var(--space-xl); } }
</style>
