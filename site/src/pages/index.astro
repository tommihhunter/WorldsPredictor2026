---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import NextUp from '../components/NextUp.astro';
import OddsList from '../components/OddsList.astro';
import { live, overview } from '../lib/data';
import { grade, nzToday, pickemPoints, today } from '../lib/grading';
import { liveStage } from '../lib/nav';
import { url } from '../lib/url';

const o = overview();
const lv = live();
const todays = today();
const stage = liveStage();
const STAGE_NAME: Record<string, string> = { 'play-in': 'Play-In', swiss: 'Swiss', knockouts: 'Knockouts' };
const rec = grade().find((g) => g.set === 'baseline');
const pts = pickemPoints().find((p) => p.stage === STAGE_NAME[stage]);
const lock = o.next_lock ?? '';
const lockAt = /\d\d\/\d\d\/\d{4} \d\d:\d\d/.exec(lock)?.[0];
const [ver, ...verRest] = (o.model_version ?? 'UNKNOWN').split(':');
---
<Base title="Home" active="home">
  <header>
    <div class="title"><img src={url('art/poro/main-512.webp')} width="72" height="72" alt="The Poro Prophet" /><h1>Worlds 2026 Predictor</h1></div>
    <p class="muted">Picks for every series, live title odds and how the frozen baseline is doing. Times in NZDT with the venue time alongside.</p>
  </header>

  <Card title={todays.length ? 'Today' : 'Next up'} note={todays.length ? `${nzToday()}, NZDT` : 'The next open series'} tone="gold">
    <NextUp rows={todays.length ? todays : undefined} />
    <a class="more" href={url(`${stage}/`)}>Full bracket and picks</a>
  </Card>

  <div class="grid-2">
    <Card>
      <div class="card-head"><h3>Title odds <span class="pill gold">Live</span></h3><span class="cap muted">{lv[0] ? `Refitted ${lv[0].generated_nz}` : 'Refit time UNKNOWN'}</span></div>
      <OddsList rows={lv.map((x) => ({ code: x.team, p: x.p_champion }))} top={10} />
      <a class="more" href={url('teams/')}>All 19 teams</a>
    </Card>
    <div class="grid-4 tiles home-tiles">
      <div class="card tile"><span class="label">Record</span><b>{rec ? `${rec.correct} / ${rec.n}` : '0 / 0'}</b><span class="cap muted">{rec?.n ? 'winners, frozen baseline' : 'No results entered yet.'}</span></div>
      <div class="card tile"><span class="label">Pick'Ems</span><b>{pts ? `${pts.earned} / ${pts.max ?? 'UNKNOWN'}` : 'UNKNOWN'}</b><span class="cap muted">{pts ? `${STAGE_NAME[stage]}, ${pts.possible} points decided so far` : `${STAGE_NAME[stage]} picks not available yet.`}</span></div>
      <div class="card tile"><span class="label">Next lock</span><b>{lockAt ?? 'UNKNOWN'}</b><span class="cap muted">{lock || 'Not available yet.'}</span></div>
      <div class="card tile"><span class="label">Model</span><b>{ver}</b><span class="cap muted">{verRest.join(':').trim() || 'UNKNOWN'}. Ratings as of {lv[0]?.as_of ?? 'UNKNOWN'}.</span></div>
    </div>
  </div>
<script is:inline src={url('js/clock.js')} defer></script>
</Base>
<style>
  header { display:flex; flex-direction:column; gap:6px; } header p { margin:0; }
  .title { display:flex; align-items:center; gap:16px; } .title img { width:72px; height:72px; border-radius:16px; flex:none; }
  @media (max-width: 640px) { .title { gap:12px; } .title img { width:48px; height:48px; border-radius:12px; } }
  .more { color:var(--gold); font-weight:600; font-size:14px; align-self:flex-start; }
  .home-tiles { grid-template-columns:1fr 1fr; align-content:start; }
  .tile { gap:4px; } .tile b { font-size:22px; }
  h3 .pill { margin-left:8px; vertical-align:middle; }
</style>
