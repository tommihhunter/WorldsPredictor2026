---
// Team page (spec option B): numbers left, scouting report pinned right; on phones one column with jump chips
// and the report last. The season / Summer toggle is two radios and CSS (same pattern as the hub toggle).
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import StatTiles from '../../components/StatTiles.astro';
import PathTable from '../../components/PathTable.astro';
import PlayersTable from '../../components/PlayersTable.astro';
import DraftBlock from '../../components/DraftBlock.astro';
import { codeFromSlug, dossiers, live, ratings, swiss, teamSlug, type Dossier, type TeamBlock } from '../../lib/data';
import { pct } from '../../lib/format';
import { latestSet } from '../../lib/stage';
import { url } from '../../lib/url';

export const getStaticPaths = () => ratings().map((r) => ({ params: { slug: teamSlug(r.code) } }));

const code = codeFromSlug(Astro.params.slug as string);
const rs = [...ratings()].sort((a, b) => a.rank - b.rank);
const r = rs.find((x) => x.code === code)!;
// players_sample and summer_sample are exported but not in the Dossier type.
const d = dossiers().find((x) => x.code === code) as (Dossier & { players_sample?: string; summer_sample?: string | null }) | undefined;
const lv = live().find((x) => x.team === code);
const set = latestSet() ?? 'baseline';
const sw = swiss().find((x) => x.set === set && x.team === code) ?? swiss().find((x) => x.set === 'baseline' && x.team === code);
const opp = rs.find((x) => x.code !== code)!.code;
const pair = [code, opp].sort().map(teamSlug).join('-vs-');

const pc1 = (v: number | null | undefined) => (v == null ? 'UNKNOWN' : `${Number(v).toFixed(1)}%`);
const gd = (v: number | null | undefined) => (v == null ? 'UNKNOWN' : `${Math.round(Number(v)) > 0 ? '+' : ''}${Math.round(Number(v))}`);
const odds: [string, string, string?][] = [
  ['Title odds', pct(lv?.p_champion, 1), `frozen baseline ${pct(r.p_champion, 1)}`],
  ['Reach knockouts', pct(lv?.p_advance, 1), `frozen baseline ${pct(r.p_advance, 1)}`],
  ['Swiss 3-0', sw ? pct(sw.p30, 1) : 'UNKNOWN', sw ? `most likely ${sw.predicted_record}` : 'Play-In team, not in the projected Swiss field'],
  ['Form', r.trend || 'UNKNOWN', d?.form || undefined],
];
const keyStats = (t: TeamBlock): [string, string, string?][] => [
  ['Win rate', pc1(t.wr), t.record], ['Gold diff @15', gd(t.gd15), t.wr_ahead15 != null ? `${pc1(t.wr_ahead15)} WR when ahead` : undefined],
  ['Blue side WR', pc1(t.blue_wr), t.blue_games != null ? `${t.blue_games} games` : undefined], ['Red side WR', pc1(t.red_wr), t.red_games != null ? `${t.red_games} games` : undefined],
  ['First blood', pc1(t.fb_pct)], ['First tower', pc1(t.ft_pct)],
  ['Dragon share', pc1(t.drag_share)], ['Baron share', pc1(t.baron_share), t.avg_game_min != null ? `avg game ${Number(t.avg_game_min).toFixed(1)} min` : undefined],
];
// Summer falls back to the season when a split is missing (as the old dashboard did); the caption says which.
const hasSummer = !!(d?.signature_summer || d?.team_summer);
const splits = [
  { key: 'season', tb: d?.team_season ?? null, tbName: '2026 season, all tournaments', players: d?.signature ?? [], summer: false, sample: d?.players_sample },
  { key: 'summer', tb: d?.team_summer ?? d?.team_season ?? null, tbName: d?.team_summer ? 'Summer split' : '2026 season (no Summer split data)', players: d?.signature_summer ?? d?.signature ?? [], summer: !!d?.signature_summer, sample: d?.signature_summer ? d?.summer_sample : d?.players_sample },
];
const REPORT: [string, keyof NonNullable<typeof d>['report']][] = [['Who they are', 'who'], ['Wins by', 'wins_by'], ['Loses to', 'loses_to'], ['Draft', 'draft']];
const sources = String(d?.sources ?? '').split(' ').filter(Boolean);
---
<Base title={r.name} active="teams" description={d?.headline}>
  <div class="teampage">
    <header class="page-head">
      <div class="id">
        <img class="logo" src={url(`art/logos/${code}.png`)} alt="" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'dot'}))" />
        <h1>{r.name}</h1>
      </div>
      <p class="caption">{r.region} seed {r.seed} · rank {r.rank} of {rs.length} · tier {r.tier} · {r.trend || 'UNKNOWN'}</p>
      <p class="links">
        <a href={url(`teams/compare/${pair}/`)}>Compare with {opp}</a><span class="caption" aria-hidden="true">·</span>
        <button type="button" onclick="navigator.clipboard.writeText(location.href).then(() => { this.textContent = 'Link copied'; })">Copy link</button><span class="caption" aria-hidden="true">·</span>
        <a href={url('teams/')}>All teams</a>
      </p>
      <nav class="jumps" aria-label="On this page">
        {[['report', 'Report'], ['path', 'Path'], ['stats', 'Stats'], ['players', 'Players'], ['draft', 'Draft']].map(([id, l]) => <a class="chip" href={`#${id}`}>{l}</a>)}
      </nav>
    </header>

    <div class="cols">
      <div class="left">
        <section class="section odds" aria-label="Odds"><StatTiles tiles={odds} /></section>
        <div id="path"><Card title="Path through Worlds" note="Times NZDT."><PathTable code={code} /></Card></div>
        <div id="stats">
          <Card title="Key stats" note="From the gol.gg team page.">
            <div class="seg" role="radiogroup" aria-label="Split">
              <input type="radio" name="split" id="split-season" value="season" checked />
              <label class="chip" for="split-season">2026 season</label>
              <input type="radio" name="split" id="split-summer" value="summer" disabled={!hasSummer} />
              <label class="chip" for="split-summer">{hasSummer ? 'Summer split' : 'No Summer data'}</label>
            </div>
            {splits.map((s) => (
              <div data-split={s.key}>
                {s.tb ? <><StatTiles tiles={keyStats(s.tb)} /><p class="caption">Sample: {s.tb.games} games, {s.tbName} (gol.gg team page).</p></> : <p class="caption">Key stats not available yet.</p>}
              </div>
            ))}
          </Card>
        </div>
        <div id="players">
          <Card title="Players and champion pools">
            {splits.map((s) => (
              <div data-split={s.key}>
                <PlayersTable players={s.players} summer={s.summer} />
                <p class="caption">Sample: {s.sample || 'UNKNOWN'}.</p>
              </div>
            ))}
          </Card>
        </div>
        <div id="draft">
          <Card title="Draft habits" note="From gol.gg.">
            {splits.map((s) => <div data-split={s.key}>{s.tb ? <DraftBlock t={s.tb} pool={d?.pool_depth} /> : <p class="caption">Draft data not available yet.</p>}</div>)}
          </Card>
        </div>
        <Card title="Sources" note="Accessed 15/10/2026.">
          {sources.length ? <ul class="src">{sources.map((u) => <li><a href={u} target="_blank" rel="noopener">{u.replace(/^https?:\/\/(www\.)?/, '').slice(0, 80)}</a></li>)}</ul> : <p class="caption">No sources listed.</p>}
          {d && <p class="caption">Full dossier: research/teams/{code}.md</p>}
        </Card>
      </div>

      <aside id="report" class="report">
        <Card title="Scouting report" panel>
          {d ? REPORT.map(([h, k]) => <section><h4>{h}</h4><p>{d.report?.[k] || 'UNKNOWN'}</p></section>) : <p class="caption">Dossier not available yet.</p>}
        </Card>
      </aside>
    </div>
  </div>
</Base>
<style>
  .teampage { display: flex; flex-direction: column; gap: var(--space-xl); }
  .id { display: flex; align-items: center; gap: var(--space-md); min-width: 0; }
  .logo { height: var(--space-2xl); width: auto; max-width: calc(var(--space-2xl) * 1.5); object-fit: contain; flex: none; }
  .id :global(.dot) { width: var(--space-md); height: var(--space-md); border-radius: var(--radius-data); background: var(--color-data); flex: none; }
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs); font-size: var(--text-sm); }
  .links a, .links button { color: var(--color-ink-2); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: var(--space-3xs); }
  .links button { font: inherit; font-weight: 600; background: none; border: 0; padding: 0; cursor: pointer; transition: color var(--dur-short) var(--ease-out); }
  .links button:hover { color: var(--color-accent); }
  .jumps { display: none; gap: var(--space-2xs); flex-wrap: wrap; margin-top: var(--space-2xs); }
  .jumps .chip { border-radius: var(--radius-data); }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, calc(var(--space-3xl) * 3)); gap: var(--space-lg); align-items: start; }
  .left { display: flex; flex-direction: column; gap: var(--space-xl); min-width: 0; }
  .odds :global(.stat:nth-child(4) b) { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); letter-spacing: -0.02em; line-height: 1.29; overflow-wrap: anywhere; }
  .report { position: sticky; top: var(--space-md); }
  .report section { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .report h4 { margin: 0; font-size: var(--text-sm); font-weight: 600; color: var(--color-ink); }
  .report p { color: var(--color-ink-2); font-size: var(--text-sm); }
  .seg { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .seg input { position: absolute; opacity: 0; width: 0; height: 0; margin: 0; }
  .seg input:checked + .chip { background: var(--color-ink); color: var(--color-paper); }
  .seg input:disabled + .chip { cursor: default; opacity: 0.6; }
  .seg input:focus-visible + .chip { outline: calc(var(--space-3xs) / 2) solid var(--color-focus); outline-offset: calc(var(--space-3xs) / 2); }
  :global(.teampage:has(input[value="season"]:checked) [data-split="summer"]), :global(.teampage:has(input[value="summer"]:checked) [data-split="season"]) { display: none; }
  [data-split] { display: flex; flex-direction: column; gap: var(--space-xs); }
  .src { margin: 0; padding-left: var(--space-md); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .src a { color: var(--color-ink-2); text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: var(--space-3xs); }
  @media (max-width: 900px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    .report { position: static; }
    .jumps { display: flex; }
  }
  @media (max-width: 640px) {
    .teampage, .left { gap: var(--space-lg); }
    .logo { height: var(--space-xl); }
  }
</style>
