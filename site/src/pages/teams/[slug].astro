---
// Team page, laid out in the order a fan reads it (redesign 17/10/2026):
//   1. who they are and their title chance   2. the road: chance of reaching each stage, then the fixtures
//   3. how they win and how they lose, and recent form   4. the numbers, each ranked against the other 18 teams
//   5. the roster   6. draft habits   7. small print (coach, sample, sources)   8. previous / next team.
// The season / Summer toggle is two radios and CSS (:has), switching every [data-split] block on the page.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import ChampIcon from '../../components/ChampIcon.astro';
import Icon from '../../components/Icon.astro';
import PathTable from '../../components/PathTable.astro';
import DraftBlock from '../../components/DraftBlock.astro';
import { codeFromSlug, displayName, dossiers, live, overview, ratings, teamSlug, type Dossier, type Player, type TeamBlock } from '../../lib/data';
import { nzProse, pct1 as pc } from '../../lib/format';
import { url } from '../../lib/url';
import { playerSlug } from '../../lib/players';
import art from '../../lib/art.json';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

export const getStaticPaths = () => ratings().map((r) => ({ params: { slug: teamSlug(r.code) } }));

const code = codeFromSlug(Astro.params.slug as string);
const rs = [...ratings()].sort((a, b) => a.rank - b.rank);
const r = rs.find((x) => x.code === code)!;
// previous / next team in rank order, wrapping round the field
const at = rs.indexOf(r);
const prev = rs[(at - 1 + rs.length) % rs.length];
const next = rs[(at + 1) % rs.length];
// players_sample and summer_sample are exported but not in the Dossier type.
type D = Dossier & { players_sample?: string; summer_sample?: string | null };
const all = dossiers() as D[];
const d = all.find((x) => x.code === code);
const lv = live().find((x) => x.team === code);
const opp = rs.find((x) => x.code !== code)!.code;
const pair = [code, opp].sort().map(teamSlug).join('-vs-');

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const name = displayName(r.name);
const headline = nzProse(d?.headline || r.headline || 'UNKNOWN');

// ---- 1. hero
const title = lv?.p_champion ?? r.p_champion;
const trend = r.trend ? cap(r.trend.toLowerCase()) : 'UNKNOWN';
// hero art: splash of the team's most-picked champion this season, when the art was fetched (model/fetch_art.py)
const topPick = d?.team_season?.picks?.[0]?.champ;
const splashId = topPick ? (art as Record<string, string>)[topPick.toLowerCase().replace(/[^a-z]/g, '')]?.replace(/\.png$/, '') : undefined;
const splash = splashId && existsSync(resolve(process.cwd(), 'public', 'art', 'splash', `${splashId}.jpg`)) ? url(`art/splash/${splashId}.jpg`) : null;
const trendTone = /peak|ris/i.test(trend) ? 'teal' : /fad/i.test(trend) ? 'risk' : 'muted';

// ---- 2. the road: chance of reaching each stage (live odds when the bot has refitted, else the frozen ratings)
const playin = lv ? lv.p_playin_win : r.p_playin;
const road: { k: string; p: number | null; note?: string }[] = [
  playin == null ? { k: 'Swiss stage', p: null, note: 'Seeded straight in' } : { k: 'Win the Play-In', p: playin },
  { k: 'Advance from Swiss', p: lv?.p_advance ?? r.p_advance },
  { k: 'Reach the semifinal', p: lv?.p_semis ?? r.p_semis },
  { k: 'Reach the final', p: lv?.p_final ?? r.p_final },
  { k: 'Win Worlds', p: title },
];
const adj = Number(r.adj_logit) || 0;

// ---- 3. scouting report and form
const clean = (v: string | null | undefined) => cap((v || 'UNKNOWN').trim().replace(/^(by|to) /, ''));
// form: "dd/mm/yyyy OPP a-b | ..." -> newest first, last three
const form = String(d?.form ?? '').split('|').map((x) => x.trim()).filter(Boolean).slice(-3).reverse().map((x) => {
  const m = /^(\d\d\/\d\d\/\d{4})\s+(\S+)\s+(\d+)-(\d+)/.exec(x);
  if (!m) return { raw: x };
  const [, date, vs, a, b] = m;
  return { date, vs, score: `${a}-${b}`, win: Number(a) > Number(b) };
});

// ---- 4. the numbers, ranked against the field for the same split
const ord = (n: number) => { const s = ['th', 'st', 'nd', 'rd'], v = n % 100; return `${n}${s[(v - 20) % 10] || s[v] || s[0]}`; };
const blockOf = (x: D, key: string): TeamBlock | null => (key === 'summer' ? (x.team_summer ?? x.team_season) : x.team_season) ?? null;
type Fmt = (v: number) => string;
const P: Fmt = (v) => `${v.toFixed(1)}%`;
const GD: Fmt = (v) => `${Math.round(v) > 0 ? '+' : ''}${Math.round(v)}`;
const N1: Fmt = (v) => v.toFixed(1);
const MIN: Fmt = (v) => `${v.toFixed(1)} min`;
// [field, label, format, higher is better (null: no rank), optional sub-line]
type Item = [keyof TeamBlock, string, Fmt, boolean | null, ((t: TeamBlock) => string)?];
const GROUPS: { title: string; items: Item[] }[] = [
  { title: 'Results', items: [['wr', 'Win rate', P, true, (t) => t.record], ['kills_pg', 'Kills per game', N1, true], ['deaths_pg', 'Deaths per game', N1, false], ['avg_game_min', 'Average game', MIN, null]] },
  { title: 'Early game', items: [['fb_pct', 'First blood', P, true], ['ft_pct', 'First tower', P, true], ['gd15', 'Gold lead at 15', GD, true], ['wr_ahead15', 'Win rate when ahead at 15', P, true]] },
  { title: 'Objectives', items: [['drag_share', 'Dragon share', P, true], ['herald_share', 'Herald share', P, true], ['baron_share', 'Baron share', P, true]] },
  { title: 'Sides', items: [['blue_wr', 'Blue side win rate', P, true, (t) => `${t.blue_games} games`], ['red_wr', 'Red side win rate', P, true, (t) => `${t.red_games} games`]] },
];
const statRows = (key: string, t: TeamBlock, items: Item[]) => items.map(([f, label, fmt, hib, sub]) => {
  const v = t[f] as unknown as number | null | undefined;
  const value = v == null || Number.isNaN(Number(v)) ? 'UNKNOWN' : fmt(Number(v));
  let rank = '', tone = 'muted';
  if (hib != null && v != null) {
    const field = all.map((x) => blockOf(x, key)?.[f] as unknown as number | null | undefined).filter((x): x is number => x != null && !Number.isNaN(Number(x)));
    const better = field.filter((x) => (hib ? x > Number(v) : x < Number(v))).length;
    const n = field.length, k = better + 1;
    rank = `${ord(k)} of ${n}`;
    tone = k <= 5 ? 'teal' : k > n - 5 ? 'risk' : 'muted';
  }
  const icon = ({ gd15: 'gold', drag_share: 'dragon', baron_share: 'baron', herald_share: 'herald', ft_pct: 'tower' } as Record<string, string>)[f as string] ?? '';
  return { label, value, rank, tone, sub: sub ? sub(t) : '', icon };
});

// ---- 5. roster
const ROLE: Record<string, string> = { TOP: 'Top', JNG: 'Jungle', JUNGLE: 'Jungle', MID: 'Mid', ADC: 'Bot', BOT: 'Bot', SUP: 'Support', SUPPORT: 'Support' };
const kda = (p: Player) => (p.kda == null ? 'UNKNOWN' : Number(p.kda).toFixed(1));
const gd15 = (p: Player) => (p.gd15 == null ? 'UNKNOWN' : GD(Number(p.gd15)));

// Summer falls back to the season when a split is missing (as the old dashboard did); the sample line says which.
const hasSummer = !!(d?.signature_summer || d?.team_summer);
const splits = [
  { key: 'season', tb: d?.team_season ?? null, tbName: '2026 season', players: d?.signature ?? [], sample: d?.players_sample },
  { key: 'summer', tb: d?.team_summer ?? d?.team_season ?? null, tbName: d?.team_summer ? 'Summer split' : '2026 season (no Summer split data)', players: d?.signature_summer ?? d?.signature ?? [], sample: d?.signature_summer ? d?.summer_sample : d?.players_sample },
];
const sampleText = (s?: string | null) => (s ? s.replace(/;\s*champion pools show[^;]*$/i, '') : 'UNKNOWN');

// ---- 7. small print: a source URL as a readable host and a short label from its path
const source = (u: string) => {
  let x: URL;
  try { x = new URL(u); } catch { return { host: u, label: '' }; }
  const segs = x.pathname.split('/').filter(Boolean).map((t) => { try { return decodeURIComponent(t); } catch { return t; } });
  const keep = segs.map((t) => t.replace(/^tournament-ALL$/i, 'all tournaments'))
    .filter((t) => !/^([a-z]{2}(-[a-z]{2})?|[\w-]*-ALL|season-S\d+|matches)$/i.test(t));
  let last = (keep.at(-1) ?? '').replace(/^tournament-|^\d+-/i, '');
  if (/^\d+$/.test(last) && keep.length > 1) last = `${keep.at(-2)} ${last}`;
  const kind = x.hostname.endsWith('gol.gg') ? (segs[1] ?? '').replace(/^tournament-/, '') : '';
  let label = [kind, last].filter(Boolean).join(', ').replace(/[-_]+/g, ' ').trim();
  if (label.length > 64) label = `${label.slice(0, label.lastIndexOf(' ', 64))}…`;
  return { host: x.hostname.replace(/^www\./, ''), label: label && cap(label) };
};
const sources = String(d?.sources ?? '').split(' ').filter(Boolean).map((u, i, list) => {
  const sr = source(u);
  const same = list.slice(0, i).filter((v) => { const o = source(v); return o.host === sr.host && o.label === sr.label; }).length;
  return { u, ...sr, label: same ? `${sr.label} (${same + 1})` : sr.label };
});
const adjSource = String(r.adj_source || 'UNKNOWN').split(/(https?:\/\/\S+)/).filter(Boolean);
const asOf = overview().ratings_as_of ?? 'UNKNOWN';
const accessed = String(d?.players_sample ?? '').match(/accessed (\d{2}\/\d{2}\/\d{4})/)?.[1] ?? 'UNKNOWN';
---
<Base title={name} active="teams" description={headline} footer={{ left: `Ratings as of ${asOf}. Team stats: gol.gg, accessed ${accessed}. Player photos: LoL Esports (Riot Games).` }}>
  <a class="back" href={url('teams/')}><span aria-hidden="true">←</span> All teams</a>

  <!-- 1. who they are -->
  <header class:list={['hero', { art: splash }]} style={splash ? `--splash:url(${splash})` : undefined}>
    <span class="disc crest"><Logo code={code} size={84} /></span>
    <div class="who">
      <span class="eyebrow reg"><Icon name={r.region} size={22} />{r.region} seed {r.seed}, ranked {ord(r.rank)} of {rs.length} by the model</span>
      <h1>{name}</h1>
      <p class="story">{headline}</p>
      <p class="acts">
        <a href={url(`teams/compare/${pair}/`)}>Compare with {opp} <span aria-hidden="true">→</span></a>
        <button type="button" class="copy" aria-live="polite">Copy link</button>
      </p>
    </div>
    <div class="odds">
      <span class="big gold">{pc(title)}</span>
      <span class="muted2">to win Worlds</span>
      <span class:list={['trend', trendTone]}>{trend}</span>
    </div>
    {splash && <span class="art-cap caption">Signature pick: {topPick}</span>}
  </header>
  <script is:inline>
    document.querySelector('.acts .copy')?.addEventListener('click', async (e) => {
      const b = e.currentTarget;
      try { await navigator.clipboard.writeText(location.href); b.textContent = 'Link copied'; }
      catch { b.textContent = 'Copy failed: use the address bar'; }
    });
  </script>

  <!-- 2. the road -->
  <section class="section">
    <div class="section-head"><h2>The road to the trophy</h2><span>Chance of reaching each stage{lv ? ', live odds' : ''}</span></div>
    <ol class="road">
      {road.map((s, i) => (
        <li class:list={[{ end: i === road.length - 1 }]}>
          <span class="step">{s.k}</span>
          <span class="pv">{s.p == null ? 'Direct' : pc(s.p)}</span>
          {s.p == null ? <span class="caption">{s.note}</span> : <span class="bar alt"><i style={`width:${Math.max(1, s.p * 100).toFixed(1)}%`}></i></span>}
        </li>
      ))}
    </ol>
    {adj !== 0 && (
      <div class="callout adj">
        <span class="eyebrow">Manual adjustment: {adj > 0 ? '+' : ''}{adj.toFixed(2)} logit</span>
        <p>{r.adj_reason || 'UNKNOWN'}</p>
        <p class="caption">Source: {adjSource.map((t) => (t.startsWith('http') ? <a href={t} target="_blank" rel="noopener">{source(t).host}{source(t).label && `, ${source(t).label}`}</a> : t))}</p>
      </div>
    )}
    <details class="fixtures">
      <summary>Fixtures and our picks <span class="caption">Times NZDT</span></summary>
      <PathTable code={code} />
    </details>
  </section>

  {d ? (
    <>
      <!-- 3. how they play -->
      <section class="section">
        <div class="section-head"><h2>How they play</h2><span>Scouting report</span></div>
        <div class="panel report" id="report">
          <section class="rp"><h3>How they win</h3><p>{clean(d.report?.wins_by)}</p></section>
          <section class="rp"><h3>How they lose</h3><p>{clean(d.report?.loses_to)}</p></section>
          {form.length > 0 && (
            <div class="form">
              <span class="form-k">Form</span>
              <ol>
                {form.map((g) => ('raw' in g ? <li>{g.raw}</li> : (
                  <li>
                    <span class:list={['wl', g.win ? 'win' : 'loss']} aria-label={g.win ? 'Win' : 'Loss'}>{g.win ? 'W' : 'L'}</span>
                    <span class="fs">{g.score}</span>
                    <Logo code={g.vs} size={22} /><span class="code">{g.vs}</span>
                    <span class="caption">{g.date}</span>
                  </li>
                )))}
              </ol>
            </div>
          )}
        </div>
      </section>

      <!-- 4. the numbers -->
      <section class="section">
        <div class="section-head">
          <h2>By the numbers</h2>
          <div class="seg" role="radiogroup" aria-label="Split">
            <input type="radio" name="split" id="split-season" value="season" checked />
            <label class="chip" for="split-season">2026 season</label>
            <input type="radio" name="split" id="split-summer" value="summer" disabled={!hasSummer} />
            <label class="chip" for="split-summer">{hasSummer ? 'Summer split' : 'No Summer data'}</label>
          </div>
        </div>
        <p class="caption">Each number is ranked against the other teams at Worlds. Top five in teal, bottom five in red.</p>
        {splits.map((s) => (
          <div class="groups" data-split={s.key}>
            {s.tb ? GROUPS.map((g) => (
              <div class="panel group">
                <h3>{g.title}</h3>
                <ul class="srows">
                  {statRows(s.key, s.tb!, g.items).map((x) => (
                    <li>
                      <span class="sl"><span class="slt">{x.icon && <Icon name={x.icon} size={22} />}{x.label}</span>{x.sub && <span class="caption">{x.sub}</span>}</span>
                      <span class="sv">{x.value}</span>
                      <span class:list={['sr', x.tone]}>{x.rank}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )) : <p class="caption">Key stats not available yet.</p>}
          </div>
        ))}
      </section>

      <!-- 5. roster -->
      <section class="section" id="players">
        <div class="section-head"><h2>The roster</h2><span>Coach {d.coach || 'UNKNOWN'}</span></div>
        {splits.map((s) => (
          <div class="roster" data-split={s.key}>
            {s.players.length ? s.players.map((p) => (
              <a class="panel player-row" href={url(`players/${playerSlug(p.player)}/`)}>
                <span class="pp">{existsSync(resolve(process.cwd(), 'public', 'art', 'players', `${playerSlug(p.player)}.webp`)) && <img src={url(`art/players/${playerSlug(p.player)}.webp`)} alt="" width="260" height="200" loading="lazy" />}</span>
                <span class="role"><Icon name={p.role} size={26} label={ROLE[String(p.role).toUpperCase()] ?? p.role} /></span>
                <span class="code pn">{p.player}</span>
                <dl class="pstats"><div><dt>KDA</dt><dd>{kda(p)}</dd></div><div><dt>Gold at 15</dt><dd>{gd15(p)}</dd></div></dl>
                <ul class="pchamps">{(p.champs ?? []).slice(0, 3).map((c) => <li><ChampIcon name={c.champ} size={28} /></li>)}</ul>
              </a>
            )) : <p class="caption">No player data found.</p>}
          </div>
        ))}
        {splits.map((s) => <p class="caption" data-split={s.key}>Players: {sampleText(s.sample)}.</p>)}
      </section>

      <!-- 6. draft -->
      <section class="section">
        <div class="section-head"><h2>Draft habits</h2><span>From gol.gg</span></div>
        <div class="panel draft">
          {d.report?.draft && <p class="fg2">{d.report.draft}</p>}
          {splits.map((s) => <div data-split={s.key}>{s.tb ? <DraftBlock t={s.tb} pool={d.pool_depth} /> : <p class="caption">Draft data not available yet.</p>}</div>)}
        </div>
      </section>
    </>
  ) : <p class="caption">Dossier not available yet.</p>}

  <!-- 7. small print -->
  <details class="fine">
    <summary>Sources and sample <span class="caption">{sources.length} sources, accessed {accessed}</span></summary>
    {d && <p class="caption">{splits.map((s) => <span data-split={s.key}>Team stats: {s.tb ? `${s.tb.games} games, ${s.tbName}, gol.gg` : 'UNKNOWN'}.</span>)}</p>}
    {sources.length ? <ul class="srcs">{sources.map((x) => <li><a href={x.u} target="_blank" rel="noopener" title={x.u}><span class="host">{x.host}</span> <span class="lbl">{x.label || x.u}</span></a></li>)}</ul> : <p class="caption">No sources listed.</p>}
  </details>

  <!-- 8. other teams -->
  <nav class="pager" aria-label="Other teams">
    <a class="card pg prev" href={url(`teams/${teamSlug(prev.code)}/`)}>
      <span class="caption"><span aria-hidden="true">←</span> Previous</span>
      <span class="pg-t"><Logo code={prev.code} size={36} /><span class="code">{displayName(prev.name)}</span></span>
    </a>
    <a class="card pg next" href={url(`teams/${teamSlug(next.code)}/`)}>
      <span class="caption">Next <span aria-hidden="true">→</span></span>
      <span class="pg-t"><span class="code">{displayName(next.name)}</span><Logo code={next.code} size={36} /></span>
    </a>
  </nav>
</Base>
<style>
  /* back link */
  .back { align-self: flex-start; display: inline-flex; gap: var(--space-2xs); font-size: var(--fs-sm); font-weight: 600; color: var(--muted); margin-bottom: calc(var(--space-xl) * -1 + var(--space-sm)); }

  /* 1. hero: crest, identity, odds */
  .hero { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-lg); align-items: center; padding-bottom: var(--space-lg); border-bottom: 1px solid var(--line); }
  /* splash of the signature champion behind the hero, faded into the page on the left and bottom */
  .hero { position: relative; isolation: isolate; }
  .hero.art { padding: var(--space-xl) var(--space-lg) var(--space-lg); border-bottom: 0; border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .hero.art::before { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--splash) right 20% / auto 140% no-repeat; opacity: 0.55; }
  .hero.art::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--surface) 30%, rgba(30, 25, 57, 0.75) 60%, rgba(30, 25, 57, 0.35)), linear-gradient(0deg, var(--surface), transparent 40%); }
  .art-cap { position: absolute; right: var(--space-lg); bottom: var(--space-sm); font-size: var(--fs-xs); }
  .reg { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .crest { --s: 128px; background: var(--surface); box-shadow: var(--inset); }
  .who { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; }
  .story { font-size: var(--fs-lg); line-height: 1.45; color: var(--fg2); max-width: 62ch; text-wrap: pretty; }
  .acts { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-top: var(--space-2xs); font-size: var(--fs-sm); font-weight: 600; }
  .acts a, .acts button { color: var(--gold); background: none; border: 0; padding: var(--space-3xs) 0; cursor: pointer; }
  .acts a:hover, .acts button:hover { color: var(--fg); }
  .odds { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-3xs); text-align: right; }
  .odds .big { font-size: var(--fs-hero); }
  .trend { margin-top: var(--space-2xs); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }

  /* 2. road: five steps that narrow */
  .road { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-sm); }
  .road li { display: flex; flex-direction: column; gap: var(--space-2xs); padding: var(--space-md); background: var(--surface); border-radius: var(--radius); box-shadow: var(--inset); position: relative; }
  .road li:not(.end)::after { content: '›'; position: absolute; right: calc(var(--space-sm) * -0.75); top: 50%; transform: translateY(-50%); color: var(--dim); font-size: var(--fs-xl); z-index: 1; }
  .road .step { font-size: var(--fs-sm); color: var(--muted); }
  .road .pv { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-2xl); line-height: 1; }
  .road .end { box-shadow: var(--inset-warm); background: var(--surface-warm); }
  .road .end .bar > i { background: var(--gold); }
  .fixtures, .fine { border-top: 1px solid var(--line); padding-top: var(--space-sm); }
  .fixtures summary, .fine summary { cursor: pointer; font-weight: 600; display: flex; gap: var(--space-sm); align-items: baseline; list-style: none; }
  .fixtures summary::before, .fine summary::before { content: '+'; color: var(--gold); width: 1ch; }
  .fixtures[open] summary::before, .fine[open] summary::before { content: '−'; }
  .fixtures summary:hover, .fine summary:hover { color: var(--gold); }
  .fixtures[open] summary { margin-bottom: var(--space-sm); }

  /* 3. report: one surface, two halves split by a rule, quiet labels over the text; a form guide along the foot */
  .report { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0; }
  .rp { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-lg); min-width: 0; }
  .rp + .rp { border-left: 1px solid var(--line-strong); }
  .rp h3 { font-family: var(--font-body); font-size: var(--fs-sm); font-weight: 600; letter-spacing: 0.08em; color: var(--muted); }
  .rp p { font-size: var(--fs-lg); line-height: 1.5; text-wrap: pretty; }
  .form { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-lg); padding: var(--space-sm) var(--space-lg); border-top: 1px solid var(--line); }
  .form-k { font-size: var(--fs-sm); font-weight: 600; letter-spacing: 0.08em; color: var(--muted); text-transform: uppercase; }
  .form ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-xl); }
