---
// Team dossier (design/lore/Teams.dc.html dossier panel, Phone Pages.dc.html): logo disc, name, headline, title %;
// the path strip; the manual adjustment callout; 8 stat cells; wins by / loses to / form / coach / sample; players.
// Below: path through Worlds, draft habits, sources. The season / Summer toggle is two radios and CSS (:has),
// switching every [data-split] block on the page.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import PathTable from '../../components/PathTable.astro';
import PlayersTable from '../../components/PlayersTable.astro';
import DraftBlock from '../../components/DraftBlock.astro';
import { codeFromSlug, displayName, dossiers, live, overview, ratings, teamSlug, type Dossier, type TeamBlock } from '../../lib/data';
import { nzProse, pct1 as pc } from '../../lib/format';
import { url } from '../../lib/url';

export const getStaticPaths = () => ratings().map((r) => ({ params: { slug: teamSlug(r.code) } }));

const code = codeFromSlug(Astro.params.slug as string);
const rs = [...ratings()].sort((a, b) => a.rank - b.rank);
const r = rs.find((x) => x.code === code)!;
// previous / next team in rank order, wrapping round the field
const at = rs.indexOf(r);
const prev = rs[(at - 1 + rs.length) % rs.length];
const next = rs[(at + 1) % rs.length];
// players_sample and summer_sample are exported but not in the Dossier type.
const d = dossiers().find((x) => x.code === code) as (Dossier & { players_sample?: string; summer_sample?: string | null }) | undefined;
const lv = live().find((x) => x.team === code);
const opp = rs.find((x) => x.code !== code)!.code;
const pair = [code, opp].sort().map(teamSlug).join('-vs-');

const pc1 = (v: number | null | undefined) => (v == null ? 'UNKNOWN' : `${Number(v).toFixed(1)}%`);
const gd = (v: number | null | undefined) => (v == null ? 'UNKNOWN' : `${Math.round(Number(v)) > 0 ? '+' : ''}${Math.round(Number(v))}`);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const name = displayName(r.name);
const headline = nzProse(d?.headline || r.headline || 'UNKNOWN');
// a source URL as a readable host and a short label from its path: locale, id and "ALL" segments dropped, slug to words
const source = (u: string) => {
  let x: URL;
  try { x = new URL(u); } catch { return { host: u, label: '' }; }
  const segs = x.pathname.split('/').filter(Boolean).map((t) => { try { return decodeURIComponent(t); } catch { return t; } });
  const keep = segs.map((t) => t.replace(/^tournament-ALL$/i, 'all tournaments'))
    .filter((t) => !/^([a-z]{2}(-[a-z]{2})?|[\w-]*-ALL|season-S\d+|matches)$/i.test(t));
  let last = (keep.at(-1) ?? '').replace(/^tournament-|^\d+-/i, '');
  if (/^\d+$/.test(last) && keep.length > 1) last = `${keep.at(-2)} ${last}`;
  const kind = x.hostname.endsWith('gol.gg') ? (segs[1] ?? '').replace(/^tournament-/, '') : '';
  let label = [kind, last].filter(Boolean).join(', ').replace(/[-_]+/g, ' ').trim();
  if (label.length > 64) label = `${label.slice(0, label.lastIndexOf(' ', 64))}…`;
  return { host: x.hostname.replace(/^www\./, ''), label: label && cap(label) };
};
// players_sample ends with a note about five champions with games and win rate; the table shows the top three names only
const sampleText = (s?: string | null) => (s ? s.replace(/;\s*champion pools show[^;]*$/i, '') : 'UNKNOWN');

const playin = lv ? lv.p_playin_win : r.p_playin;
const trend = r.trend ? cap(r.trend.toLowerCase()) : 'UNKNOWN';
const path: [string, string][] = [
  ['Win Play-In', playin == null ? 'Direct' : pc(playin)],
  ['Advance from Swiss', pc(lv?.p_advance ?? r.p_advance)],
  ['Reach semifinal', pc(lv?.p_semis ?? r.p_semis)],
  ['Reach final', pc(lv?.p_final ?? r.p_final)],
  ['Trend', trend],
];
const adj = Number(r.adj_logit) || 0;
// adj_source is "url ; url (accessed dd/mm/yyyy)": links for the URLs, text for the rest.
const adjSource = String(r.adj_source || 'UNKNOWN').split(/(https?:\/\/\S+)/).filter(Boolean);

const stats = (t: TeamBlock): [string, string][] => [
  [pc1(t.wr), `Win rate, ${t.record ?? 'UNKNOWN'}`], [gd(t.gd15), 'Gold diff at 15'],
  [pc1(t.blue_wr), 'Blue side win rate'], [pc1(t.red_wr), 'Red side win rate'],
  [pc1(t.fb_pct), 'First blood'], [pc1(t.ft_pct), 'First tower'],
  [pc1(t.drag_share), 'Dragon share'], [pc1(t.baron_share), 'Baron share'],
];
// Summer falls back to the season when a split is missing (as the old dashboard did); the sample line says which.
const hasSummer = !!(d?.signature_summer || d?.team_summer);
const splits = [
  { key: 'season', tb: d?.team_season ?? null, tbName: '2026 season', players: d?.signature ?? [], sample: d?.players_sample },
  { key: 'summer', tb: d?.team_summer ?? d?.team_season ?? null, tbName: d?.team_summer ? 'Summer split' : '2026 season (no Summer split data)', players: d?.signature_summer ?? d?.signature ?? [], sample: d?.signature_summer ? d?.summer_sample : d?.players_sample },
];
const clean = (v: string | null | undefined) => cap((v || 'UNKNOWN').trim().replace(/^(by|to) /, ''));
const form = String(d?.form ?? '').split('|').map((x) => x.trim()).filter(Boolean).slice(-3).join(', ') || 'UNKNOWN';
// repeated labels (several player pages of one event) get a counter so every link reads differently
const sources = String(d?.sources ?? '').split(' ').filter(Boolean).map((u, i, all) => {
  const sr = source(u);
  const same = all.slice(0, i).filter((v) => { const o = source(v); return o.host === sr.host && o.label === sr.label; }).length;
  return { u, ...sr, label: same ? `${sr.label} (${same + 1})` : sr.label };
});
const asOf = overview().ratings_as_of ?? 'UNKNOWN';
const accessed = String(d?.players_sample ?? '').match(/accessed (\d{2}\/\d{2}\/\d{4})/)?.[1] ?? 'UNKNOWN';
---
<Base title={name} active="teams" description={headline} footer={{ left: `Ratings as of ${asOf}. Team stats: gol.gg, accessed ${accessed}.` }}>
  <a class="back" href={url('teams/')}><span class="gold" aria-hidden="true">←</span> Teams</a>

  <section class="panel dossier" aria-label="Dossier">
    <div class="head">
      <span class="disc lg"><Logo code={code} size={66} /></span>
      <div class="who">
        <span class="eyebrow"><span class="dt">Dossier, </span>{r.region} seed {r.seed}</span>
        <h1>{name}</h1>
      </div>
      <p class="headline">{headline}</p>
      <div class="tp">
        <span class="big gold">{pc(lv?.p_champion ?? r.p_champion)}</span>
        <span class="muted2"><span class="dt">to win Worlds</span><span class="ph">title</span></span>
      </div>
    </div>

    <div class="path">
      {path.map(([k, v]) => <div><span class="k">{k}</span><span class="v">{v}</span></div>)}
    </div>

    {adj !== 0 && (
      <div class="callout adj">
        <span class="eyebrow">Manual adjustment: {adj > 0 ? '+' : ''}{adj.toFixed(2)} logit</span>
        <p>{r.adj_reason || 'UNKNOWN'}</p>
        <p class="caption src">Source: {adjSource.map((t) => (t.startsWith('http') ? <a href={t} target="_blank" rel="noopener">{source(t).host}{source(t).label && `, ${source(t).label}`}</a> : t))}</p>
      </div>
    )}

    {d ? (
      <div class="body">
        <div class="seg" role="radiogroup" aria-label="Split">
          <span class="caption">Stats and players</span>
          <input type="radio" name="split" id="split-season" value="season" checked />
          <label class="chip" for="split-season">2026 season</label>
          <input type="radio" name="split" id="split-summer" value="summer" disabled={!hasSummer} />
          <label class="chip" for="split-summer">{hasSummer ? 'Summer split' : 'No Summer data'}</label>
        </div>
        {splits.map((s) => (
          <div class="stats" data-split={s.key}>
            {s.tb ? stats(s.tb).map(([v, k]) => <div><span class="k">{k}</span><span class="v">{v}</span></div>) : <p class="caption">Key stats not available yet.</p>}
          </div>
        ))}
        <div class="two">
          <dl id="report" class="facts">
            <dt>Wins by</dt><dd>{clean(d.report?.wins_by)}</dd>
            <dt>Loses to</dt><dd>{clean(d.report?.loses_to)}</dd>
            <dt>Last 3 series</dt><dd>{form}</dd>
            <dt>Coach</dt><dd>{d.coach || 'UNKNOWN'}</dd>
            <dt>Sample</dt><dd>{splits.map((s) => <span data-split={s.key}>{s.tb ? `${s.tb.games} games, ${s.tbName}, gol.gg` : 'UNKNOWN'}</span>)}</dd>
          </dl>
          <div id="players" class="players">
            <h2 class="ph">Players</h2>
            <PlayersTable splits={splits.map((s) => ({ key: s.key, players: s.players }))} />
            {splits.map((s) => <p class="caption" data-split={s.key}>Players: {sampleText(s.sample)}.</p>)}
          </div>
        </div>
      </div>
    ) : <p class="caption">Dossier not available yet.</p>}
  </section>

  <p class="links">
    <a href={url(`teams/compare/${pair}/`)}>Compare with {opp} →</a>
    <button type="button" class="copy" aria-live="polite">Copy link</button>
    <a href={url('teams/')}>All teams</a>
  </p>
  <script is:inline>
    document.querySelector('.links .copy')?.addEventListener('click', async (e) => {
      const b = e.currentTarget;
      try { await navigator.clipboard.writeText(location.href); b.textContent = 'Link copied'; }
      catch { b.textContent = 'Copy failed: use the address bar'; }
    });
  </script>

  <section class="section">
    <div class="section-head"><h2>Path through Worlds</h2><span>Times NZDT</span></div>
    <div class="panel"><PathTable code={code} /></div>
  </section>

  {d && (
    <section class="section">
      <div class="section-head"><h2>Draft habits</h2><span>From gol.gg</span></div>
      <div class="panel draft">
        {d.report?.draft && <p class="fg2">{d.report.draft}</p>}
        {splits.map((s) => <div data-split={s.key}>{s.tb ? <DraftBlock t={s.tb} pool={d.pool_depth} /> : <p class="caption">Draft data not available yet.</p>}</div>)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head"><h2>Sources</h2><span>Accessed {accessed}</span></div>
    {sources.length ? <ul class="srcs">{sources.map((x) => <li><a href={x.u} target="_blank" rel="noopener" title={x.u}><span class="host">{x.host}</span><span class="lbl">{x.label || x.u}</span></a></li>)}</ul> : <p class="caption">No sources listed.</p>}
  </section>

  <nav class="pager" aria-label="Other teams">
    <a class="card pg prev" href={url(`teams/${teamSlug(prev.code)}/`)}>
      <span class="pg-k"><span class="gold" aria-hidden="true">←</span> Previous team</span>
      <span class="pg-t"><Logo code={prev.code} size={40} /><span class="code">{displayName(prev.name)}</span></span>
    </a>
    <a class="card pg all" href={url('teams/')}><span class="code">All teams</span></a>
    <a class="card pg next" href={url(`teams/${teamSlug(next.code)}/`)}>
      <span class="pg-k">Next team <span class="gold" aria-hidden="true">→</span></span>
      <span class="pg-t"><span class="code">{displayName(next.name)}</span><Logo code={next.code} size={40} /></span>
    </a>
  </nav>
</Base>
<style>
  /* back link sits 16px above the dossier instead of the 48px section gap */
  .back { display: inline-flex; gap: var(--space-2xs); align-items: center; align-self: flex-start; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: var(--track-caps); color: var(--fg2); padding: var(--space-3xs) 0; margin-bottom: calc(var(--space-sm) - var(--space-xl)); }
  .back:hover { color: var(--gold); }
  .back:active { color: var(--muted2); }
  .back .gold { font-size: var(--fs-lg); line-height: 1; }

  .ph { display: none; }
  .dossier { display: flex; flex-direction: column; gap: var(--space-lg); padding: var(--space-lg); }
  .head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; column-gap: var(--space-md); row-gap: var(--space-xs); align-items: center; }
  .lg { --s: 108px; grid-row: 1 / 3; }
  .who { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; align-self: end; }
  .headline { grid-column: 2; align-self: start; font-size: var(--fs-lg); line-height: 1.45; color: var(--fg2); max-width: 64ch; text-wrap: pretty; }
  /* the title % is the page's one gold number */
  .tp { grid-column: 3; grid-row: 1 / 3; display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2xs); }
  .tp .big { font-size: var(--fs-hero); }
  .tp .muted2 { font-size: var(--fs-sm); }

  /* path strip and stat cells: label above value, hairline-ruled, flush with the content edge */
  .path { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .path > div, .stats > div { display: flex; flex-direction: column; gap: var(--space-3xs); min-width: 0; padding: var(--space-sm) var(--space-md) var(--space-sm) 0; }
  .k { font-size: var(--fs-sm); color: var(--muted); }
  .path .v, .stats .v { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-xl); line-height: var(--lh-tight); text-transform: uppercase; letter-spacing: var(--track-caps); }
  .adj { gap: var(--space-2xs); }
  .src { overflow-wrap: anywhere; }
  .src a { color: var(--gold); }
  .src a:hover { color: var(--fg); }

  .body { display: flex; flex-direction: column; gap: var(--space-md); }
  .seg { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs); }
  .seg .caption { margin-right: var(--space-2xs); }
  .seg input { position: absolute; opacity: 0; width: 0; height: 0; margin: 0; }
  .seg label { cursor: pointer; border-color: var(--split-off); }
  .seg input:not(:checked):not(:disabled) + label:hover { color: var(--gold); border-color: var(--gold); }
  .seg input:not(:checked):not(:disabled) + label:active { color: var(--muted2); }
  .seg input:checked + label { background: var(--gold); border-color: var(--gold); color: var(--bg); }
  .seg input:disabled + label { cursor: default; opacity: 0.6; }
  .seg input:focus-visible + label { outline: 2px solid var(--gold); outline-offset: 2px; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .stats > div { border-bottom: 1px solid var(--line); }
  .stats .k { color: var(--fg2); }

  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: var(--space-lg) var(--space-2xl); align-items: start; padding-top: var(--space-2xs); }
  .facts { margin: 0; display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--space-xs) var(--space-md); line-height: 1.5; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; min-width: 0; }
  .players { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; }
  :global(main:has(#split-season:checked) [data-split="summer"]),
  :global(main:has(#split-summer:checked) [data-split="season"]) { display: none !important; }

  /* action links sit 24px under the dossier */
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs) var(--space-md); font-weight: 600; margin-top: calc(var(--space-md) - var(--space-xl)); }
  .links a, .links button { color: var(--gold); padding: var(--space-3xs) 0; }
  .links button { font: inherit; background: none; border: 0; cursor: pointer; transition: color 120ms ease; }
  .links a:hover, .links button:hover { color: var(--fg); }
  .links a:active, .links button:active { color: var(--muted2); }

  .draft { display: flex; flex-direction: column; gap: var(--space-md); }
  .draft > p { max-width: 90ch; }

  /* sources: host over a short label, ruled rows in two columns */
  .srcs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); column-gap: var(--space-lg); }
  .srcs li { border-top: 1px solid var(--line); min-width: 0; }
  .srcs a { display: flex; flex-direction: column; padding: var(--space-xs) 0; min-width: 0; }
  .srcs .host { font-weight: 600; color: var(--fg); transition: color 120ms ease; }
  .srcs .lbl { font-size: var(--fs-sm); color: var(--muted); overflow-wrap: anywhere; }
  .srcs a:hover .host { color: var(--gold); }
  .srcs a:active .host { color: var(--muted2); }

  .pager { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-sm); }
  .pg { gap: var(--space-2xs); padding: var(--space-sm) var(--space-md); }
  .pg:hover { border-color: var(--gold); }
  .pg:active { background: var(--surface); }
  .pg-k { font-size: var(--fs-sm); color: var(--muted); }
  .pg-t { display: flex; align-items: center; gap: var(--space-xs); }
  .pg-t .code { font-size: var(--fs-lg); }
  .next { align-items: flex-end; text-align: right; }
  .all { justify-content: center; align-items: center; padding: var(--space-sm) var(--space-lg); }
  .all .code { color: var(--fg2); }

  @media (max-width: 1100px) {
    .path { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .back { margin-bottom: calc(var(--space-2xs) - var(--space-lg)); }
    .dt { display: none; }
    .ph { display: inline; }
    h2.ph { display: block; font-size: var(--fs-xl); }
    .dossier { background: none; box-shadow: none; padding: 0; gap: var(--space-md); border-radius: 0; }
    .head { column-gap: var(--space-sm); row-gap: var(--space-sm); }
    .lg { --s: 72px; grid-row: 1; background: var(--surface); }
    .lg :global(.logo) { --s: 44px !important; }
    .who { gap: 0; align-self: center; }
    .tp { grid-row: 1; gap: 0; }
    .tp .big { font-size: var(--fs-3xl); }
    .tp .muted2 { font-size: var(--fs-xs); color: var(--muted); }
    .headline { grid-column: 1 / -1; grid-row: 2; font-size: var(--fs-md); }
    .path { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; border: 0; background: var(--line); border-radius: var(--radius); overflow: hidden; }
    .path > div { padding: var(--space-xs) var(--space-sm); background: var(--surface); }
    .path > div:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .seg .caption { display: none; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats > div { padding: var(--space-xs) var(--space-xs) var(--space-xs) 0; }
    .facts { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .facts dd { margin-bottom: var(--space-xs); }
    .links { margin-top: calc(var(--space-2xs) - var(--space-lg)); }
    .links a, .links button { padding: var(--space-xs) 0; }
    .pager { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xs); }
    .all { grid-column: 1 / -1; grid-row: 2; padding: var(--space-xs); }
    .pg { padding: var(--space-xs) var(--space-sm); }
    .pg-t .code { font-size: var(--fs-md); }
  }
</style>
