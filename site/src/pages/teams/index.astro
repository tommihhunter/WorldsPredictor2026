---
import Base from '../../layouts/Base.astro';
import TeamCard from '../../components/TeamCard.astro';
import { dossiers, live, ratings } from '../../lib/data';
import { url } from '../../lib/url';

const rs = [...ratings()].sort((a, b) => a.rank - b.rank);
const lv = new Map(live().map((x) => [x.team, x]));
const ds = new Map(dossiers().map((x) => [x.code, x]));
const REGIONS = ['LCK', 'LPL', 'LEC', 'LCS', 'LCP', 'CBLOL'];
const TIERS = ['S', 'A', 'B', 'C'];
const SORTS: [string, string][] = [['odds', 'Title odds'], ['rating', 'Rating'], ['wr', 'Win rate'], ['gd15', 'GD@15'], ['blue', 'Blue side'], ['pool', 'Pool depth']];
---
<Base title="Teams" active="teams">
  <header class="page-head">
    <h1>Teams</h1>
    <p class="caption">{rs.length} teams in rank order. Filter by region or tier, sort by what matters to you, open a team for its scouting report.</p>
    <a class="more" href={url('teams/compare/')}>Compare two teams</a>
  </header>
  <section class="section">
    <div class="filters" hidden>
      <div class="chips" role="group" aria-label="Region"><span class="caption">Region</span><button class="chip" type="button" data-region="" aria-pressed="true">All</button>{REGIONS.map((g) => <button class="chip" type="button" data-region={g} aria-pressed="false">{g}</button>)}</div>
      <div class="chips" role="group" aria-label="Tier"><span class="caption">Tier</span><button class="chip" type="button" data-tier="" aria-pressed="true">All</button>{TIERS.map((t) => <button class="chip" type="button" data-tier={t} aria-pressed="false">{t}</button>)}</div>
      <div class="chips" role="group" aria-label="Sort"><span class="caption">Sort</span>{SORTS.map(([k, l]) => <button class="chip" type="button" data-sort={k} aria-pressed="false">{l}</button>)}</div>
    </div>
    <div id="teams-grid" class="grid">
      {rs.map((r) => <TeamCard r={r} d={ds.get(r.code)} lv={lv.get(r.code)} />)}
    </div>
    <p id="teams-empty" class="caption" hidden>No team matches those filters.</p>
  </section>
<script is:inline src={url('js/teams-grid.js')} defer></script>
</Base>
<style>
  h1 { font-size: var(--text-xl); line-height: 1.1; }
  .more { color: var(--color-ink-2); font-size: var(--text-sm); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: var(--space-3xs); align-self: flex-start; }
  .filters { display: flex; flex-direction: column; gap: var(--space-2xs); margin-bottom: var(--space-sm); }
  .filters[hidden] { display: none; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2xs); align-items: center; }
  .chips .caption { width: var(--space-2xl); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-lg); }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: minmax(0, 1fr); } .chips .caption { width: 100%; } }
</style>
