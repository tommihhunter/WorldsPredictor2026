---
// Teams (design/lore/Teams.dc.html): intro, region chips, card grid in rank order. Each card opens the team's dossier.
// Without JS every card shows and the chips stay hidden; teams-grid.js filters by region (state in location.hash).
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import TeamCard from '../../components/TeamCard.astro';
import { dossiers, overview, ratings } from '../../lib/data';
import { url } from '../../lib/url';

const rs = [...ratings()].sort((a, b) => a.rank - b.rank);
const ORDER = ['LCK', 'LPL', 'LEC', 'LCS', 'LCP', 'CBLOL'];
const present = [...new Set(rs.map((r) => r.region))];
const regions = [...ORDER.filter((g) => present.includes(g)), ...present.filter((g) => !ORDER.includes(g))];
const asOf = overview().ratings_as_of ?? 'UNKNOWN';
const accessed = dossiers().map((d) => String((d as { players_sample?: string }).players_sample ?? '').match(/accessed (\d{2}\/\d{2}\/\d{4})/)?.[1]).find(Boolean) ?? 'UNKNOWN';
---
<Base title="The field" active="teams" description="Every team at Worlds 2026, ranked by model rating." footer={{ left: `Ratings as of ${asOf}. Team stats: gol.gg, accessed ${accessed}.` }}>
  <section class="top">
    <div class="intro">
      <span class="eyebrow ph-hide">{rs.length} teams, {regions.length} regions</span>
      <h1 class="ph-hide">The field</h1>
      <p class="lede ph-hide">Ranked by model rating. Pick a team for its full dossier.</p>
      <a class="more" href={url('teams/compare/')}>Compare two teams →</a>
    </div>
    <div class="filters" role="group" aria-label="Region" hidden>
      <button class="chip" type="button" data-region="" aria-pressed="true">All</button>
      {regions.map((g) => <button class="chip" type="button" data-region={g} aria-pressed="false"><Icon name={g} size={18} label={g} /></button>)}
    </div>
  </section>
  <section id="teams-grid" class="grid" aria-label="Teams">
    {rs.map((r) => <TeamCard r={r} />)}
  </section>
  <script is:inline src={url('js/teams-grid.js')} defer></script>
</Base>
<style>
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--space-md) var(--space-xl); min-width: 0; }
  .more { font-weight: 600; color: var(--gold); align-self: flex-start; padding: var(--space-3xs) 0; }
  .more:hover { color: var(--fg); }
  .more:active { color: var(--muted2); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-2xs); min-width: 0; }
  .filters[hidden] { display: none; }
  .filters .chip { font-size: var(--fs-md); padding: var(--space-2xs) var(--space-sm); }
  .filters .chip[aria-pressed="false"] { border-color: var(--split-off); }
  .filters .chip[aria-pressed="false"]:hover { border-color: var(--gold); }
  .filters .chip[aria-pressed="false"]:active { color: var(--muted2); }
  /* cards sit 32px under the intro instead of the 48px section gap */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--space-md); margin-top: calc(var(--space-lg) - var(--space-xl)); }
  @media (max-width: 640px) {
    .top { gap: var(--space-xs); }
    .ph-hide { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .intro { order: 2; }
    /* the chip row scrolls sideways; 4px inner padding keeps the focus ring inside the scroller */
    .filters { flex-wrap: nowrap; overflow-x: auto; width: 100%; scrollbar-width: none; padding: var(--space-3xs); margin: calc(-1 * var(--space-3xs)); }
    .filters .chip { flex: none; padding: var(--space-2xs) var(--space-xs); }
    .filters .chip:focus-visible { outline-offset: -3px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xs); margin-top: calc(var(--space-sm) - var(--space-lg)); }
  }
</style>
