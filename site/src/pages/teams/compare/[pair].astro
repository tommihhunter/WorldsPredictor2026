---
// One static page per unordered pairing (171), slug <a>-vs-<b> with a < b by code.
import Base from '../../../layouts/Base.astro';
import CompareView from '../../../components/CompareView.astro';
import { pairs } from '../../../lib/compare';
import { teamName } from '../../../lib/data';
import { url } from '../../../lib/url';

export const getStaticPaths = () => pairs().map((p) => ({ params: { pair: p.slug }, props: { a: p.a, b: p.b } }));
const { a, b } = Astro.props as { a: string; b: string };
---
<Base title={`${a} v ${b}`} active="teams" description={`${teamName(a)} against ${teamName(b)}: model, 2026 season, lanes, champion pools and head to head.`}>
  <CompareView a={a} b={b} h1>
    <p class="links"><a href={url('teams/compare/')}>Pick two other teams</a><span class="caption" aria-hidden="true">·</span><a href={url('teams/')}>All teams</a></p>
  </CompareView>
</Base>
<style>
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs); font-size: var(--text-sm); }
  .links a { color: var(--color-ink-2); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: var(--space-3xs); }
  .links a:hover { color: var(--color-accent); }
</style>
