---
// One static page per unordered pairing (171), slug <a>-vs-<b> with a < b by code.
import Base from '../../../layouts/Base.astro';
import CompareView from '../../../components/CompareView.astro';
import { pairs } from '../../../lib/compare';
import { overview, teamName } from '../../../lib/data';
import { url } from '../../../lib/url';

export const getStaticPaths = () => pairs().map((p) => ({ params: { pair: p.slug }, props: { a: p.a, b: p.b } }));
const { a, b } = Astro.props as { a: string; b: string };
const asOf = overview().ratings_as_of ?? 'UNKNOWN';
---
<Base title={`${a} v ${b}`} active="teams" description={`${teamName(a)} against ${teamName(b)}: model, 2026 season, lanes, champion pools and head to head.`} footer={{ left: `Ratings as of ${asOf}. Team stats and head to head: gol.gg.` }}>
  <CompareView a={a} b={b} h1>
    <p class="links"><a href={url('teams/compare/')}>Pick two other teams</a><a href={url('teams/')}>All teams</a></p>
  </CompareView>
</Base>
<style>
  .links { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); font-weight: 600; }
  .links a { color: var(--gold); padding: var(--space-3xs) 0; }
  .links a:hover { color: var(--fg); }
  .links a:active { color: var(--muted2); }
</style>
