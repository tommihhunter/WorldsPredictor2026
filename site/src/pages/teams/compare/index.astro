---
// Picker page: two selects and Compare (compare-pick.js navigates to the canonical <min>-vs-<max> page),
// with the top two teams by rank compared below by default.
import Base from '../../../layouts/Base.astro';
import CompareView from '../../../components/CompareView.astro';
import { displayName, overview, ratings } from '../../../lib/data';
import { url } from '../../../lib/url';

const rs = [...ratings()].sort((x, y) => x.rank - y.rank);
const [a, b] = [rs[0].code, rs[1].code].sort();
const selects = [{ name: 'a', sel: rs[0].code }, { name: 'b', sel: rs[1].code }];
const asOf = overview().ratings_as_of ?? 'UNKNOWN';
---
<Base title="Compare teams" active="teams" footer={{ left: `Ratings as of ${asOf}. Team stats and head to head: gol.gg.` }}>
  <section class="intro">
    <span class="eyebrow">Teams</span>
    <h1>Compare teams</h1>
    <p class="lede">Pick two teams. Every pairing has its own page you can share. The top two by rank are below.</p>
    <form id="compare-pick" class="pick" data-base={url('teams/compare/')}>
      {selects.map((s, i) => (
        <label><span class="caption">Team {i + 1}</span>
          <select name={s.name}>{rs.map((r) => <option value={r.code} selected={r.code === s.sel}>{r.code}, {displayName(r.name)}</option>)}</select>
        </label>
      ))}
      <button class="chip on" type="submit">Compare</button>
      <p class="caption risk msg" hidden>Pick two different teams.</p>
    </form>
    <a class="more" href={url('teams/')}>All teams</a>
  </section>
  <CompareView a={a} b={b} />
  <script is:inline src={url('js/compare-pick.js')} defer></script>
</Base>
<style>
  .pick { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-xs) var(--space-sm); margin-top: var(--space-2xs); }
  .pick label { display: flex; flex-direction: column; gap: var(--space-3xs); min-width: 0; flex: 1 1 12rem; max-width: 20rem; }
  /* select and button share one 44px control height so their edges line up */
  .pick select, .pick .chip { height: 44px; }
  .pick select { font: inherit; color: var(--fg); background: var(--surface); border: 1px solid var(--split-off); border-radius: var(--radius-sm); padding: 0 var(--space-xs); width: 100%; cursor: pointer; transition: border-color 120ms ease; }
  .pick select:hover { border-color: var(--gold); }
  .pick select:active { border-color: var(--muted2); }
  .pick .chip { justify-content: center; padding: 0 var(--space-md); font-size: var(--fs-md); }
  .pick .chip:active { background: var(--muted2); border-color: var(--muted2); }
  .msg { flex-basis: 100%; }
  .msg[hidden] { display: none; }
  .more { font-weight: 600; color: var(--gold); align-self: flex-start; padding: var(--space-3xs) 0; }
  .more:hover { color: var(--fg); }
  .more:active { color: var(--muted2); }
</style>
