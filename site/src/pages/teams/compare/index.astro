---
// Picker page: two selects and Go (compare-pick.js navigates to the canonical <min>-vs-<max> page),
// with the top two teams compared below by default.
import Base from '../../../layouts/Base.astro';
import CompareView from '../../../components/CompareView.astro';
import { ratings } from '../../../lib/data';
import { url } from '../../../lib/url';

const rs = [...ratings()].sort((x, y) => x.rank - y.rank);
const [a, b] = [rs[0].code, rs[1].code].sort();
const selects = [{ name: 'a', sel: rs[0].code }, { name: 'b', sel: rs[1].code }];
---
<Base title="Compare teams" active="teams">
  <header class="page-head">
    <h1>Compare teams</h1>
    <p class="caption">Pick two teams. Every pairing has its own page you can share. The top two by rank are below.</p>
    <form id="compare-pick" class="pick" data-base={url('teams/compare/')}>
      {selects.map((s, i) => (
        <label><span class="caption">Team {i + 1}</span>
          <select name={s.name}>{rs.map((r) => <option value={r.code} selected={r.code === s.sel}>{r.code} · {r.name}</option>)}</select>
        </label>
      ))}
      <button class="chip" type="submit">Go</button>
      <p class="caption bad msg" hidden>Pick two different teams.</p>
    </form>
  </header>
  <CompareView a={a} b={b} />
<script is:inline src={url('js/compare-pick.js')} defer></script>
</Base>
<style>
  h1 { font-size: var(--text-xl); line-height: 1.1; }
  .pick { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-xs) var(--space-sm); margin-top: var(--space-2xs); }
  .pick label { display: flex; flex-direction: column; gap: var(--space-3xs); min-width: 0; flex: 1 1 12rem; max-width: 20rem; }
  .pick select { font: inherit; font-size: var(--text-sm); color: var(--color-ink); background: var(--color-paper-3); border: 0; border-radius: var(--radius-data); padding: var(--space-2xs) var(--space-xs); width: 100%; }
  .pick .chip { padding: var(--space-2xs) var(--space-md); font-weight: 600; }
  .msg { flex-basis: 100%; }
  .msg[hidden] { display: none; }
</style>
