---
/* Site footer: sources left (prop, or the default slot), fan-project disclaimer right. 14px --muted, top border --line. */
import { overview } from '../lib/data';
interface Props { left?: string; right?: string }
const exported = overview().exported_nz ?? 'UNKNOWN';
const {
  left = `Data: gol.gg, lolesports.com, official patch notes. Times in NZDT. Exported ${exported}.`,
  right = 'A fan project. Logos belong to their owners.',
} = Astro.props;
---
<footer class="foot">
  <div class="foot-in">
    <span>{Astro.slots.has('default') ? <slot /> : left}</span>
    <span>{right}</span>
  </div>
</footer>
<style>
  .foot { border-top: 1px solid var(--line); }
  .foot-in { max-width: var(--page-max); margin: 0 auto; padding: 24px var(--gutter); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: 14px; color: var(--muted); }
</style>
