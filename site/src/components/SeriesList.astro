---
// One <details> per series as a hairline row (When, Series, Pick, Call, Result); the reasoning in the body.
import Badge from './Badge.astro';
import { nz, pct } from '../lib/format';
import { resultFor, started, toUtc } from '../lib/stage';
import { dossiers, type Series, type TeamBlock } from '../lib/data';
const { rows, block, phase } = Astro.props as { rows: Series[]; block: string; phase: string };
const split = (s: Series) => (s.bo === 5 ? `3-0 ${pct(s.pw30)}, 3-1 ${pct(s.pw31)}, 3-2 ${pct(s.pw32)}` : `2-0 ${pct(s.pw20)}, 2-1 ${pct(s.pw21)}`);
const ITEMS: [string, keyof Series][] = [['Score call', 'score_note'], ['Exact-score odds', 'exact'], ['Key matchup', 'key_matchup'], ['Draft angle', 'draft_angle'], ['Form and context', 'form_context'], ['What flips it', 'what_flips'], ['Note', 'note']];
const season = (code: string) => dossiers().find((d) => d.code === code)?.team_season ?? null;
const f1 = (v: unknown) => (v == null ? 'UNKNOWN' : `${Number(v).toFixed(1)}%`);
const gd = (v: unknown) => (v == null ? 'UNKNOWN' : `${Number(v) > 0 ? '+' : ''}${Math.round(Number(v))}`);
// [label, field, format, 1 = higher is better, 0 = no comparison]
const LINES: [string, keyof TeamBlock, (v: unknown) => string, number][] = [
  ['Record', 'record', (v) => String(v ?? 'UNKNOWN'), 0], ['Win rate', 'wr', f1, 1], ['Blue side', 'blue_wr', f1, 1], ['Red side', 'red_wr', f1, 1],
  ['GD@15', 'gd15', gd, 1], ['First blood', 'fb_pct', f1, 1], ['Dragon share', 'drag_share', f1, 1], ['Baron share', 'baron_share', f1, 1],
  ['Avg game', 'avg_game_min', (v) => (v == null ? 'UNKNOWN' : `${Number(v).toFixed(1)} min`), 0],
];
const better = (u: unknown, v: unknown, hi: number) => hi > 0 && u != null && v != null && Number(u) > Number(v);
---
{rows.length ? (
  <div class="list">
    <div class="row head caption" aria-hidden="true"><span>When, NZDT</span><span>Series</span><span>Pick</span><span>Call</span><span>Result</span></div>
    {rows.map((s) => {
      const r = resultFor(s);
      const live = !r && started(s);
      const A = season(s.team_a), B = season(s.team_b);
      return (
        <details id={`s-${block}-${s.id}`} class:list={[{ started: live }]} data-start={toUtc(s)}>
          <summary class="row">
            <span class="c-when"><span class="num">{nz(s.time_nz)}</span><span class="caption when">{s.time_venue || 'Venue time TBC'}{live && ' (started)'}</span></span>
            <span class="c-series"><span class="teams"><Badge code={s.team_a} /><span class="caption">v</span><Badge code={s.team_b} /></span><span class="caption">{s.stage}</span></span>
            <span class="c-pick"><span class="pk"><Badge code={s.winner} /><span class="num">{pct(s.p_winner)}</span></span><span class:list={['tier', { lock: s.tier === 'LOCK' }]}>{s.tier}</span></span>
            <span class="c-call"><span class="num">{s.score}</span><span class="caption num">{pct(s.p_score)}</span></span>
            <span class="c-result">{r ? <span class="result">{r.winner} <span class="num">{Math.max(Number(r.score_a), Number(r.score_b))}-{Math.min(Number(r.score_a), Number(r.score_b))}</span>{!s.actual && <>, <span class={r.winner === s.winner ? 'hit' : 'miss'}>{r.winner === s.winner ? 'hit' : 'miss'}</span></>}</span> : <span class="caption">Not played</span>}</span>
          </summary>
          <div class="body">
            <p class="ink2"><b>Odds.</b> Score call {s.score} ({pct(s.p_score)}). {split(s)}, upset {pct(s.p_upset)}.</p>
            {ITEMS.filter(([, f]) => s[f]).map(([label, f]) => <p class="ink2"><b>{label}.</b> {String(s[f])}</p>)}
            {A && B ? (
              <div class="paper">
                <p class="caption">On paper: 2026 season, gol.gg. Descriptive, not used by the model.</p>
                <div class="scroll">
                  <table>
                    <thead><tr><th>2026 season</th><th class="r"><Badge code={s.team_a} /></th><th class="r"><Badge code={s.team_b} /></th></tr></thead>
                    <tbody>
                      {LINES.map(([label, f, fmt, hi]) => (
                        <tr><td class="ink2">{label}</td><td class:list={['num', { better: better(A[f], B[f], hi) }]}>{fmt(A[f])}</td><td class:list={['num', { better: better(B[f], A[f], hi) }]}>{fmt(B[f])}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ) : <p class="caption">On-paper comparison not available for this pairing.</p>}
            <p class="caption">Predicted {s.created_nz}. Exact scores list the left team first. Sources (accessed 15/10/2026): {String(s.sources || '').split(' ').filter(Boolean).slice(0, 4).map((u, i) => <>{i ? ', ' : ''}<a href={u} target="_blank" rel="noopener">{u.replace(/^https?:\/\/(www\.)?/, '').split('/')[0]}</a></>)}</p>
          </div>
        </details>
      );
    })}
  </div>
) : <p class="caption">No {phase} series predicted yet.</p>}
<style>
  .list { display: flex; flex-direction: column; font-size: var(--text-sm); }
  .row { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 0.6fr) minmax(0, 0.9fr); gap: var(--space-3xs) var(--space-sm); align-items: start; padding: var(--space-xs) 0; }
  .row > span { display: flex; flex-direction: column; gap: var(--space-3xs); min-width: 0; }
  .head { padding: 0 0 var(--space-2xs); }
  details { border-top: var(--rule); }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .teams, .pk { display: flex; align-items: center; gap: var(--space-2xs); flex-wrap: wrap; flex-direction: row; }
  .row > .c-call { flex-direction: row; gap: var(--space-2xs); align-items: baseline; }
  .body { padding: 0 0 var(--space-md); display: flex; flex-direction: column; gap: var(--space-xs); }
  .body b { color: var(--color-ink); font-weight: 600; }
  .paper { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .paper table { max-width: calc(var(--space-3xl) * 4); }
  td.better { font-weight: 600; color: var(--color-ink); }
  .body a { color: var(--color-ink-2); text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: var(--space-3xs); }
  .body a:hover { color: var(--color-accent); }
  @media (max-width: 640px) {
    .head { display: none; }
    .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "series pick" "when call" "result result"; }
    .c-when { grid-area: when; } .c-series { grid-area: series; } .c-pick { grid-area: pick; align-items: flex-end; } .c-call { grid-area: call; justify-content: flex-end; } .c-result { grid-area: result; }
  }
</style>
