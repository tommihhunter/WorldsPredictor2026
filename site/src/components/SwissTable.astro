---
// Swiss standings: predicted record and its chance, live W-L, advance chance and the six record odds. Numbers only, no bars.
import Badge from './Badge.astro';
import { pct } from '../lib/format';
import type { swiss } from '../lib/data';
type Row = ReturnType<typeof swiss>[number];
const { rows, records } = Astro.props as { rows: Row[]; records: Map<string, string> };
const ORDER = ['3-0', '3-1', '3-2', '2-3', '1-3', '0-3'];
const KEYS = ['p30', 'p31', 'p32', 'p23', 'p13', 'p03'] as const;
const list = [...rows].sort((a, b) => ORDER.indexOf(a.predicted_record) - ORDER.indexOf(b.predicted_record) || b.p_advance - a.p_advance);
---
<div class="scroll">
  <table>
    <thead><tr><th>Team</th><th class="r">Predicted</th><th class="r">Chance</th><th class="r">Live W-L</th><th class="r">Advance</th>{ORDER.map((o) => <th class="r">{o}</th>)}</tr></thead>
    <tbody>
      {list.length ? list.map((x) => (
        <tr>
          <td><Badge code={x.team} /></td>
          <td class:list={['num', { q: x.qualifies }]}>{x.predicted_record}</td>
          <td class="num">{pct(x.p_record)}</td>
          <td class="num">{records.get(x.team) ?? '0-0'}</td>
          <td class="num">{pct(x.p_advance, 1)}</td>
          {KEYS.map((k) => <td class="num ink2">{pct(x[k])}</td>)}
        </tr>
      )) : <tr><td colspan="11" class="caption">No Swiss predictions.</td></tr>}
    </tbody>
  </table>
</div>
<style>
  table { min-width: calc(var(--space-3xl) * 6); }
  td.q { font-weight: 600; }
</style>
