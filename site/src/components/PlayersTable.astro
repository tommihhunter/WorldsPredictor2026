---
// Player table from the dossier (Teams.dc.html): role, player, KDA, GD@15 and the three most-played champions.
// One tbody per split (data-split), so the page's season / Summer toggle shows one at a time. Phone drops KDA and GD@15.
import ChampIcon from './ChampIcon.astro';
import type { Player } from '../lib/data';
const { splits } = Astro.props as { splits: { key: string; players: Player[] }[] };
const ROLE: Record<string, [string, string]> = {
  TOP: ['Top', 'Top'], JNG: ['Jng', 'Jungle'], JUNGLE: ['Jng', 'Jungle'], MID: ['Mid', 'Mid'],
  ADC: ['Bot', 'Bot'], BOT: ['Bot', 'Bot'], SUP: ['Sup', 'Support'], SUPPORT: ['Sup', 'Support'],
};
const f = (v: number | null | undefined, fmt: (n: number) => string) => (v == null ? 'UNKNOWN' : fmt(Number(v)));
const gd = (n: number) => `${Math.round(n) > 0 ? '+' : ''}${Math.round(n)}`;
const role = (r: string) => ROLE[String(r).toUpperCase()] ?? [r, r];
---
<div class="scroll" tabindex="0" role="region" aria-label="Players, scrolls sideways">
  <table class="players">
    <thead><tr><th>Role</th><th>Player</th><th class="r wide">KDA</th><th class="r wide">GD@15</th><th>Most played</th></tr></thead>
    {splits.map((s) => (
      <tbody data-split={s.key}>
        {s.players.length ? s.players.map((p) => (
          <tr class="player-row">
            <td class="muted2"><span class="s">{role(p.role)[0]}</span><span class="l">{role(p.role)[1]}</span></td>
            <td class="code">{p.player}</td>
            <td class="r wide">{f(p.kda, (n) => n.toFixed(1))}</td>
            <td class="r wide">{f(p.gd15, gd)}</td>
            <td class="champs">{(p.champs ?? []).length ? <span class="cl">{(p.champs ?? []).slice(0, 3).map((c) => <ChampIcon name={c.champ} size={24} />)}</span> : 'UNKNOWN'}</td>
          </tr>
        )) : <tr><td colspan="5" class="caption">No player data found.</td></tr>}
      </tbody>
    ))}
  </table>
</div>
<style>
  .players td.champs { font-size: var(--fs-sm); color: var(--fg2); }
  .cl { display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-xs); }
  .l { display: none; }
  @media (max-width: 640px) {
    .wide { display: none; }
    .s { display: none; }
    .l { display: inline; }
    /* phone: role and player on one line, the three champions on a full-width line below, so every row is the same height */
    .players thead { display: none; }
    .players tr.player-row { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); row-gap: var(--space-3xs); padding: var(--space-2xs) 0; border-top: 1px solid var(--line); }
    .players tr.player-row td { padding: 0; border: 0; }
    .players td.champs { grid-column: 1 / -1; font-size: var(--fs-sm); }
    .cl { flex-wrap: nowrap; }
  }
</style>
