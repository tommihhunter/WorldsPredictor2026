---
// Ported from dashboard/index.html (dossiers script, players table): same number formats, five most-played champions.
import ChampIcon from './ChampIcon.astro';
import type { Player } from '../lib/data';
const { players, summer } = Astro.props as { players: Player[]; summer: boolean };
const ROLE: Record<string, string> = { TOP: 'Top', JNG: 'Jungle', JUNGLE: 'Jungle', MID: 'Mid', ADC: 'Bot', BOT: 'Bot', SUP: 'Support', SUPPORT: 'Support' };
const f = (v: number | null | undefined, fmt: (n: number) => string) => (v == null ? 'UNKNOWN' : fmt(Number(v)));
const kda = (n: number) => n.toFixed(1);
const gd = (n: number) => `${Math.round(n) > 0 ? '+' : ''}${Math.round(n)}`;
const pc1 = (n: number) => `${n.toFixed(1)}%`;
const games = (p: Player) => (p.games == null ? 'UNKNOWN' : summer && p.season_games != null ? `${p.games}/${p.season_games}` : String(p.games));
---
{players.length ? (
  <div class="scroll">
    <table class="players">
      <thead><tr><th>Role</th><th>Player</th><th class="r">Games</th><th class="r">KDA</th><th class="r">GD@15</th><th class="r">KP</th><th class="r">Pool</th></tr></thead>
      <tbody>
        {players.map((p) => (<>
          <tr class="player-row">
            <td class="ink2">{ROLE[String(p.role).toUpperCase()] ?? p.role}</td>
            <td><b>{p.player}</b></td>
            <td class="num">{games(p)}</td>
            <td class="num">{f(p.kda, kda)}</td><td class="num">{f(p.gd15, gd)}</td><td class="num">{f(p.kp, pc1)}</td>
            <td class="num">{p.n_champs ?? 'UNKNOWN'}</td>
          </tr>
          <tr class="pool"><td colspan="7"><div class="champs">{(p.champs ?? []).length ? (p.champs ?? []).slice(0, 5).map((c) => (
            <span class="ch"><ChampIcon name={c.champ} size={20} />{c.games != null && <span class="caption num">{c.games}g · {Math.round(Number(c.wr))}%</span>}</span>
          )) : <span class="caption">Champion pool UNKNOWN</span>}</div></td></tr>
        </>))}
      </tbody>
    </table>
  </div>
) : <p class="caption">No player data found.</p>}
<p class="caption">Under each player: most played, {summer ? 'Summer split' : '2026 season'} (games · win rate).{summer && ' Games reads Summer games / season games.'}</p>
<style>
  .players td { vertical-align: middle; }
  .players b { font-weight: 600; }
  .players tr.player-row td { border-bottom: 0; padding-bottom: 0; }
  .champs { display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-sm); }
  .ch { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: var(--text-xs); white-space: nowrap; }
</style>
