---
// Ported from dashboard/index.html (dossiers script, "Draft (gol.gg)" block).
import ChampIcon from './ChampIcon.astro';
import type { TeamBlock } from '../lib/data';
const { t, pool } = Astro.props as { t: TeamBlock; pool: number | null | undefined };
const ROLE: Record<string, string> = { TOP: 'Top', JNG: 'Jungle', JUNGLE: 'Jungle', MID: 'Mid', ADC: 'Bot', BOT: 'Bot', SUP: 'Support', SUPPORT: 'Support' };
const lines: [string, { champ: string; cap: string }[]][] = [
  ['Most picked', (t.picks ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.games}g · ${Math.round(c.wr)}%` }))],
  ['Banned against', (t.bans_against ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.n} · ${Math.round(c.rate)}%` }))],
  ['Own bans', (t.bans_by ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.n} · ${Math.round(c.rate)}%` }))],
  ['First picks', (t.first_picks ?? []).map((c) => ({ champ: c.champ, cap: `${c.n}×` }))],
];
const order = t.role_priority ? Object.entries(t.role_priority).sort((a, b) => a[1] - b[1]).map(([r, v]) => `${ROLE[r] ?? r} ${Number(v).toFixed(1)}`).join(' · ') : null;
---
<div class="draft">
  {lines.map(([k, cs]) => (
    <>
      <span class="k label">{k}</span>
      {cs.length ? <div class="champs">{cs.map((c) => <span class="chip"><ChampIcon name={c.champ} size={20} /><span class="cap muted">{c.cap}</span></span>)}</div> : <span class="muted cap">UNKNOWN</span>}
    </>
  ))}
  <span class="k label">Pick order</span><span class="muted cap">{order ? `${order} (average pick slot per role, lower = earlier)` : 'UNKNOWN'}</span>
  <span class="k label">Pool depth</span><span class="muted cap">{pool == null ? 'UNKNOWN' : `${Number(pool).toFixed(1)} champions per player (picked in 2 or more games, model/pools.py)`}</span>
</div>
<style>
  .draft { display:grid; grid-template-columns:130px minmax(0,1fr); gap:10px 16px; align-items:center; }
  .champs { display:flex; flex-wrap:wrap; gap:6px; }
  .chip { display:inline-flex; align-items:center; gap:6px; padding:2px 8px 2px 2px; border-radius:8px; background:var(--raised); font-size:13px; white-space:nowrap; }
  @media (max-width: 640px) { .draft { grid-template-columns:1fr; gap:4px; } .k { margin-top:8px; } }
</style>
