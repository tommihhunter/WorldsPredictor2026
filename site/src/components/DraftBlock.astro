---
// Ported from dashboard/index.html (dossiers script, "Draft (gol.gg)" block). A definition list with hairlines between rows.
import ChampIcon from './ChampIcon.astro';
import type { TeamBlock } from '../lib/data';
const { t, pool } = Astro.props as { t: TeamBlock; pool: number | null | undefined };
const ROLE: Record<string, string> = { TOP: 'Top', JNG: 'Jungle', JUNGLE: 'Jungle', MID: 'Mid', ADC: 'Bot', BOT: 'Bot', SUP: 'Support', SUPPORT: 'Support' };
const lines: [string, { champ: string; cap: string }[]][] = [
  ['Most picked', (t.picks ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.games}g · ${Math.round(c.wr)}%` }))],
  ['Banned against', (t.bans_against ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.n} · ${Math.round(c.rate)}%` }))],
  ['Own bans', (t.bans_by ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.n} · ${Math.round(c.rate)}%` }))],
  ['First picks', (t.first_picks ?? []).map((c) => ({ champ: c.champ, cap: `${c.n}×` }))],
];
const order = t.role_priority ? Object.entries(t.role_priority).sort((a, b) => a[1] - b[1]).map(([r, v]) => `${ROLE[r] ?? r} ${Number(v).toFixed(1)}`).join(' · ') : null;
---
<dl class="draft">
  {lines.map(([k, cs]) => (
    <div class="row">
      <dt class="caption">{k}</dt>
      <dd>{cs.length ? <span class="champs">{cs.map((c) => <span class="ch"><ChampIcon name={c.champ} size={20} /><span class="caption num">{c.cap}</span></span>)}</span> : <span class="caption">UNKNOWN</span>}</dd>
    </div>
  ))}
  <div class="row">
    <dt class="caption">Pick order</dt>
    <dd>{order ? <><span class="num">{order}</span> <span class="caption">Average pick slot per role, lower is earlier.</span></> : <span class="caption">UNKNOWN</span>}</dd>
  </div>
  <div class="row">
    <dt class="caption">Pool depth</dt>
    <dd>{pool == null ? <span class="caption">UNKNOWN</span> : <><span class="num">{Number(pool).toFixed(1)}</span> <span class="caption">champions per player, picked in 2 or more games (model/pools.py).</span></>}</dd>
  </div>
</dl>
<style>
  .draft { margin: 0; display: flex; flex-direction: column; }
  .row { display: grid; grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); gap: var(--space-3xs) var(--space-sm); align-items: center; padding: var(--space-2xs) 0; border-top: var(--rule); }
  .row:first-child { border-top: 0; padding-top: 0; }
  dd { margin: 0; font-size: var(--text-sm); min-width: 0; }
  .champs { display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-sm); }
  .ch { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: var(--text-xs); white-space: nowrap; }
  @media (max-width: 640px) { .row { grid-template-columns: minmax(0, 1fr); } }
</style>
