---
// Draft habits from gol.gg: a definition list with hairlines between rows (lore system).
import ChampIcon from './ChampIcon.astro';
import Icon from './Icon.astro';
import type { TeamBlock } from '../lib/data';
const { t, pool } = Astro.props as { t: TeamBlock; pool: number | null | undefined };
const ROLE: Record<string, string> = { TOP: 'Top', JNG: 'Jungle', JUNGLE: 'Jungle', MID: 'Mid', ADC: 'Bot', BOT: 'Bot', SUP: 'Support', SUPPORT: 'Support' };
const lines: [string, { champ: string; cap: string }[]][] = [
  ['Most picked', (t.picks ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.games}g · ${Math.round(c.wr)}%` }))],
  ['Banned against', (t.bans_against ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.n} · ${Math.round(c.rate)}%` }))],
  ['Own bans', (t.bans_by ?? []).slice(0, 6).map((c) => ({ champ: c.champ, cap: `${c.n} · ${Math.round(c.rate)}%` }))],
  ['First picks', (t.first_picks ?? []).map((c) => ({ champ: c.champ, cap: `${c.n}×` }))],
];
// roles in the order the team picks them (average pick slot, lower is earlier)
const order = t.role_priority ? Object.entries(t.role_priority).sort((a, b) => a[1] - b[1]).map(([r, v]) => ({ r, name: ROLE[r] ?? r, v: Number(v).toFixed(1) })) : null;
---
<dl class="draft">
  {lines.map(([k, cs]) => (
    <div class="row">
      <dt class="caption">{k}</dt>
      <dd>{cs.length ? <span class="champs">{cs.map((c) => <span class="ch"><ChampIcon name={c.champ} size={20} /><span class="caption num">{c.cap}</span></span>)}</span> : <span class="caption">UNKNOWN</span>}</dd>
    </div>
  ))}
  <div class="row">
    <dt class="caption">Pick order</dt>
    <dd>{order ? <><ol class="order">{order.map((o) => <li><Icon name={o.r} size={22} label={o.name} /><span class="caption num">{o.v}</span></li>)}</ol><span class="caption">Average pick slot per role, earliest first.</span></> : <span class="caption">UNKNOWN</span>}</dd>
  </div>
  <div class="row">
    <dt class="caption">Pool depth</dt>
    <dd>{pool == null ? <span class="caption">UNKNOWN</span> : <><span class="num">{Number(pool).toFixed(1)}</span> <span class="caption">champions per player, picked in 2 or more games.</span></>}</dd>
  </div>
</dl>
<style>
  .draft { margin: 0; display: flex; flex-direction: column; }
  .row { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: var(--space-3xs) var(--space-md); align-items: baseline; padding: var(--space-xs) 0; border-top: 1px solid var(--line); }
  .row:first-child { border-top: 0; padding-top: 0; }
  dt { font-size: var(--fs-md); }
  dd { margin: 0; min-width: 0; }
  .champs { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); }
  .ch { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: var(--fs-sm); white-space: nowrap; }
  .order { list-style: none; margin: 0 0 var(--space-3xs); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); }
  .order li { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .order li + li::before { content: '›'; color: var(--dim); margin-right: var(--space-2xs); }
  @media (max-width: 640px) { .row { grid-template-columns: minmax(0, 1fr); } }
</style>
