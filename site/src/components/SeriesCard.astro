---
/* One series in a bracket, per design/lore/Play-In.dc.html and Knockouts.dc.html.
   Favourite on top with its win chance (or the final score once played), a split bar and a note.
   detail = id of a SeriesDetail to show: renders a selectable <button> (public/js/select.js), otherwise a static card.
   round = phone meta label (the bracket column); label = round name shown before the time on desktop too. */
import Logo from './Logo.astro';
import Tier from './Tier.astro';
import { pct } from '../lib/format';
import { resultFor } from '../lib/stage';
import type { Series } from '../lib/data';
interface Props { s: Series; detail?: string; selected?: boolean; final?: boolean; round?: string; label?: string; large?: boolean }
const { s, detail, selected = false, final = false, round, label, large = false } = Astro.props;
const fav = s.winner || s.team_a;
const dog = fav === s.team_a ? s.team_b : s.team_a;
const r = resultFor(s);
const goals = (code: string) => (!r ? null : r.team_a === code ? r.score_a : r.score_b);
const [gf, gd] = [goals(fav), goals(dog)];
const pa = s.p_winner == null ? null : Math.round(s.p_winner * 100);
const when = (s.time_nz || '').match(/^(\d\d\/\d\d)\/\d{4} (\d\d:\d\d)/);
const time = when ? `${when[1]} ${when[2]}` : 'TBC';
const hit = !!r && r.winner === fav;
const hi = r ? Math.max(Number(r.score_a), Number(r.score_b)) : 0;
const lo = r ? Math.min(Number(r.score_a), Number(r.score_b)) : 0;
const note = !r
  ? `Likeliest ${fav} ${s.score || 'UNKNOWN'} (${pct(s.p_score)})`
  : hit ? `Called it. Score call ${s.score} ${`${hi}-${lo}` === s.score ? 'hit' : 'missed'}` : `Missed. ${r.winner} won ${hi}-${lo}`;
const lead = r ? (r.winner === dog ? 1 : 0) : 0;
const rows = [
  { code: fav, right: r ? String(gf ?? 'UNKNOWN') : pct(s.p_winner) },
  { code: dog, right: r ? String(gd ?? 'UNKNOWN') : s.p_winner == null ? 'UNKNOWN' : pct(1 - s.p_winner) },
];
const Tag = detail ? 'button' : 'div';
const attrs = detail ? { type: 'button', 'data-show': detail, 'aria-controls': detail, 'aria-pressed': String(selected) } : {};
---
<Tag class:list={['card', 'sc', { 'is-selected': selected, 'is-final': final, lg: large }]} {...attrs}>
  {round && (
    <span class="meta ph">
      <span>{label ?? round}, {time}</span>
      {r ? <span class:list={['tag', hit ? 'gold' : 'risk']}>{hit ? 'Called it' : 'Missed'}</span> : <Tier tier={s.tier} />}
    </span>
  )}
  <span class="meta dt"><span>{label ? `${label}, ` : ''}{time}</span><Tier tier={s.tier} /></span>
  <span class="teams dt">
    {rows.map((x, i) => (
      <>
        <Logo code={x.code} size={large ? 34 : 28} />
        <span class:list={['code', 'name', { second: i === 1 }]}>{x.code}</span>
        <span class:list={['big', 'val', i === lead ? 'teal' : 'dim']}>{x.right}</span>
      </>
    ))}
  </span>
  <span class="split dt" style={`--pa:${pa ?? 50}`} aria-hidden="true"><i></i><i></i></span>
  <span class:list={['note', 'dt', r ? (hit ? 'gold' : 'risk') : 'fg2']}>{note}</span>
  <span class="line ph">
    <Logo code={fav} size={24} />
    <span class="code">{fav}</span>
    <span class="vs">v {dog}</span>
    <span class:list={['big', 'pv', r ? '' : 'teal']}>{r ? `${hi}-${lo}` : pct(s.p_winner)}</span>
  </span>
</Tag>
<style>
  .sc { gap: 12px; }
  div.sc { cursor: default; }
  div.sc:hover { background: var(--surface); }
  .sc.lg { padding: 18px 22px; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 15px; color: var(--muted); }
  .teams { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 6px 12px; }
  .lg .teams { grid-template-columns: 34px minmax(0, 1fr) auto; gap: 8px 14px; }
  .name { font-size: 19px; min-width: 0; overflow-wrap: anywhere; }
  .name.second { font-weight: 600; color: var(--muted2); }
  .lg .name { font-size: 22px; }
  .val { font-size: 24px; text-align: right; }
  .lg .val { font-size: 28px; }
  .note { font-size: 15px; }
  .ph { display: none; }
  .tag { font-size: 13px; font-weight: 600; }
  @media (max-width: 640px) {
    .dt { display: none; }
    .ph { display: flex; }
    .sc, .sc.lg { gap: 8px; padding: 14px 16px; }
    .meta { font-size: 13px; }
    .line { align-items: center; gap: 10px; min-width: 0; }
    .line .code { font-size: 17px; }
    .vs { font-size: 15px; color: var(--dim); min-width: 0; overflow-wrap: anywhere; }
    .pv { margin-left: auto; font-size: 22px; }
    .sc:not(:has(.meta.ph)) { padding: 12px 14px; border-radius: 12px; }
    .sc:not(:has(.meta.ph)) .code { font-size: 16px; }
    .sc:not(:has(.meta.ph)) .vs { font-size: 14px; }
    .sc:not(:has(.meta.ph)) .pv { font-size: 20px; }
  }
</style>
