---
/* Phone bottom bar (< 640px), per design/lore/Phone Pages.dc.html: Home, Play-In, Swiss, Teams, More.
   7px rotated-square marker over a 13px label, gold when active. More is a <details> bottom sheet. */
import { NAV } from '../lib/nav';
import { url } from '../lib/url';
const { active } = Astro.props as { active: string };
const pick = (id: string) => NAV.find((n) => n.id === id)!;
const tabs = ['home', 'play-in', 'swiss', 'teams'].map(pick);
const more = ['knockouts', 'scorecard', 'meta', 'demacia-cup'].map(pick);
const moreOn = more.some((n) => n.id === active);
---
<nav class="bbar" aria-label="Sections">
  {tabs.map((n) => <a class="tab" href={url(n.path)} aria-current={active === n.id ? 'page' : undefined}><i class="mk" aria-hidden="true" />{n.label}</a>)}
  <details class="more">
    <summary class:list={['tab', { on: moreOn }]}><i class="mk" aria-hidden="true" />More</summary>
    <div class="scrim" aria-hidden="true"></div>
    <div class="sheet">
      <span class="grab" aria-hidden="true"></span>
      {more.map((n) => <a href={url(n.path)} aria-current={active === n.id ? 'page' : undefined}><span class="t">{n.label}</span><span class="s">{n.desc}</span></a>)}
    </div>
  </details>
</nav>
<script is:inline>
  // close the More sheet on a tap outside it or on Escape
  document.addEventListener('click', (e) => { const d = document.querySelector('.bbar details[open]'); if (d && !e.target.closest('.sheet, .bbar summary')) d.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') document.querySelectorAll('.bbar details[open]').forEach((d) => { d.open = false; d.querySelector('summary').focus(); }); });
</script>
<style>
  .bbar { display: none; }
  @media (max-width: 640px) {
    .bbar {
      display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      padding: 8px 4px max(12px, env(safe-area-inset-bottom)); font-size: 13px; font-weight: 600; text-align: center;
    }
    /* layers: scrim 0, sheet 1, bar background 2, tabs 3 */
    .bbar::before { content: ''; position: absolute; inset: 0; z-index: 2; background: var(--bg); border-top: 1px solid var(--line-strong); }
    .tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; min-height: 44px; color: var(--fg2); white-space: nowrap; cursor: pointer; list-style: none; position: relative; z-index: 3; }
    .tab::-webkit-details-marker { display: none; }
    .mk { width: 7px; height: 7px; transform: rotate(45deg); background: transparent; box-shadow: inset 0 0 0 1px var(--marker); }
    .tab[aria-current="page"], .tab.on, .more[open] > .tab { color: var(--gold); }
    .tab[aria-current="page"] .mk, .tab.on .mk, .more[open] > .tab .mk { background: var(--gold); }
    .scrim { position: fixed; inset: 0; background: var(--scrim); z-index: 0; }
    .sheet {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 1;
      display: flex; flex-direction: column; gap: 4px; text-align: left;
      background: var(--surface); border-radius: 22px 22px 0 0;
      padding: 12px 18px calc(84px + env(safe-area-inset-bottom));
      max-height: 100dvh; overflow-y: auto; overscroll-behavior: contain;
    }
    .grab { align-self: center; width: 40px; height: 4px; border-radius: 2px; background: var(--split-off); margin-bottom: 12px; }
    .sheet a { display: flex; flex-direction: column; gap: 2px; padding: 14px 12px; border-radius: var(--radius-sm); min-height: 44px; }
    .sheet a:hover, .sheet a[aria-current="page"] { background: var(--hover); }
    .sheet .t { font-family: var(--font-display); font-weight: 700; font-size: 18px; }
    .sheet a[aria-current="page"] .t { color: var(--gold); }
    .sheet .s { font-size: 14px; font-weight: 500; color: var(--muted); }
    .more { display: block; }
  }
</style>
