---
import { NAV, liveStage } from '../lib/nav';
import { url } from '../lib/url';
const { active } = Astro.props as { active: string };
const live = liveStage();
const pick = (id: string) => NAV.find((n) => n.id === id)!;
const main = [pick('home'), pick(live), pick('teams'), pick('scorecard')];
const more = NAV.filter((n) => !main.includes(n));
---
<nav class="bottombar" aria-label="Sections">
  {main.map((n) => <a href={url(n.path)} aria-current={active === n.id ? 'page' : undefined}><i></i>{n.label}</a>)}
  <details><summary><i></i>More</summary><div class="sheet">{more.map((n) => <a href={url(n.path)} aria-current={active === n.id ? 'page' : undefined}>{n.label}</a>)}</div></details>
</nav>
