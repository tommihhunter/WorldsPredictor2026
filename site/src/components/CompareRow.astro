---
// One compare row: value | label, verdict | value. Bars are scaled to the larger value; the leading side is gold.
// No bars when lower is better (rank) or a side is UNKNOWN; no leader when the verdict is "about the same".
import { show, type Row } from '../lib/compare';
const { row } = Astro.props as { row: Row };
const [l, r] = row.bar ?? [typeof row.left === 'number' ? row.left : null, typeof row.right === 'number' ? row.right : null];
const both = l != null && r != null;
const even = row.verdict.startsWith('about the same');
const lead = !both || even || row.higherIsBetter == null || l === r ? '' : (l > r) === row.higherIsBetter ? 'l' : 'r';
const bars = both && row.higherIsBetter !== false;
const scale = Math.max(Math.abs(l ?? 0), Math.abs(r ?? 0)) || 1;
const w = (v: number | null) => `width:${((Math.abs(v ?? 0) / scale) * 100).toFixed(1)}%`;
---
<div class="crow">
  <div class="side l">
    <b class:list={[{ gold: lead === 'l', muted: row.left == null }]}>{show(row.left, row.fmt)}</b>
    {bars && <div class="bar"><i class:list={[{ lead: lead === 'l' }]} style={w(l)} /></div>}
  </div>
  <div class="mid"><span class="label">{row.label}</span><span class="cap verdict">{row.verdict}</span></div>
  <div class="side r">
    <b class:list={[{ gold: lead === 'r', muted: row.right == null }]}>{show(row.right, row.fmt)}</b>
    {bars && <div class="bar"><i class:list={[{ lead: lead === 'r' }]} style={w(r)} /></div>}
  </div>
</div>
<style>
  .crow { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.1fr) minmax(0,1fr); gap:12px; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); }
  .crow:last-child { border-bottom:0; }
  .side { display:flex; flex-direction:column; gap:6px; min-width:0; overflow-wrap:anywhere; }
  .side b { font-weight:600; }
  .side.l { align-items:flex-end; text-align:right; }
  .side .bar { width:100%; height:8px; display:flex; }
  .side.l .bar { justify-content:flex-end; }
  .mid { display:flex; flex-direction:column; align-items:center; text-align:center; gap:2px; min-width:0; }
  .verdict { color:var(--fg2); }
  @media (max-width: 640px) {
    .crow { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:6px 12px; font-size:13px; }
    .mid { grid-column:1 / -1; order:-1; }
  }
</style>
