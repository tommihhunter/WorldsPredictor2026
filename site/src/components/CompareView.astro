---
// The comparison body, shared by /teams/compare/<a>-vs-<b>/ and the picker page's default view.
// The matchup in display type (the h1 on a pair page, `h1`), the two sides with swap chips, the summary strip as the
// page's one panel with the Bo1 / Bo3 / Bo5 switch (radios and :has, no script), then the five metric groups. No verdict box.
import Card from './Card.astro';
import ChampIcon from './ChampIcon.astro';
import CompareRow from './CompareRow.astro';
import { metrics, slugOf, summary } from '../lib/compare';
import { dossiers, ratings, teamSlug } from '../lib/data';
import { url } from '../lib/url';

const { a, b, h1 = false } = Astro.props as { a: string; b: string; h1?: boolean };
const H = h1 ? 'h1' : 'h2';
const rs = [...ratings()].sort((x, y) => x.rank - y.rank);
const groups = metrics(a, b);
const strips = summary(a, b);
const side = (code: string, other: string) => ({
  code,
  r: rs.find((x) => x.code === code),
  d: dossiers().find((x) => x.code === code),
  swaps: rs.filter((x) => x.code !== code && x.code !== other).slice(0, 10).map((x) => ({ code: x.code, href: url(`teams/compare/${slugOf(x.code, other)}/`) })),
});
const sides = [side(a, b), side(b, a)];
---
<div class="compare">
  <header class="page-head">
    <H class="matchup"><a href={url(`teams/${teamSlug(a)}/`)}>{a}</a> <span class="v">v</span> <a href={url(`teams/${teamSlug(b)}/`)}>{b}</a></H>
    <slot />
    <div class="sides">
      {sides.map((s) => (
        <div class="side">
          <a class="name" href={url(`teams/${teamSlug(s.code)}/`)}>
            <img class="logo" src={url(`art/logos/${s.code}.png`)} alt="" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'dot'}))" />
            {s.r?.name ?? s.code}
          </a>
          <p class="caption">{s.r ? `${s.r.region} seed ${s.r.seed} · rank ${s.r.rank} · tier ${s.r.tier}` : 'UNKNOWN'}</p>
          <p class="caption">{s.d?.roster || 'Roster UNKNOWN'}</p>
          <div class="swaps"><span class="caption">Swap {s.code} for</span>{s.swaps.map((x) => <a class="chip" href={x.href}>{x.code}</a>)}</div>
        </div>
      ))}
    </div>
  </header>

  <section class="panel">
    <div class="section-head">
      <h2>Summary</h2>
      <div class="seg" role="radiogroup" aria-label="Series format">
        {strips.map((s) => <><input type="radio" name="bo" id={`bo-${s.fmt}`} value={s.fmt} checked={s.fmt === 'Bo3'} /><label class="chip" for={`bo-${s.fmt}`}>{s.fmt}</label></>)}
      </div>
    </div>
    {strips.map((s) => (
      <div data-bo={s.fmt}>
        <p class="caption">Model win chance for a {s.fmt}, from matchups.json, with live title odds and rank.</p>
        <div class="rows">{s.rows.map((row, i) => <CompareRow row={row} strip gold={i === 0} />)}</div>
      </div>
    ))}
  </section>

  {groups.map((g) => (
    <Card title={g.title}>
      {g.title !== 'Head to head' && <div class="cols caption"><span>{a}</span><span /><span>{b}</span></div>}
      {g.title === 'Head to head'
        ? g.rows.length > 0 && <div class="rows">{g.rows.map((row) => {
            const [date, ...ev] = row.label.split(' · ');
            return <div class="hrow"><span class="num">{date}</span><span class="caption">{ev.join(' · ')}</span><span class:list={['num', 'score', { win: row.left !== row.right }]}>{row.verdict}</span></div>;
          })}</div>
        : g.rows.length > 0 && <div class="rows">{g.rows.map((row) => <CompareRow row={row} />)}</div>}
      {g.shared && (g.shared.length
        ? <div class="chips"><span class="caption">Shared picks ({g.shared.length})</span>{g.shared.map((c) => <span class="ch"><ChampIcon name={c} size={20} /></span>)}</div>
        : <p class="caption">No shared champions in the two teams' most-picked lists.</p>)}
      {g.note && <p class="caption">{g.note}</p>}
    </Card>
  ))}
</div>
<style>
  .compare { display: contents; }
  .matchup { font-size: var(--text-display); line-height: 1; }
  .v { font-size: var(--text-lg); color: var(--color-ink-3); font-weight: 500; vertical-align: middle; }
  .sides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm) var(--space-lg); margin-top: var(--space-sm); }
  .side { display: flex; flex-direction: column; gap: var(--space-3xs); min-width: 0; }
  .side p { overflow-wrap: anywhere; }
  .name { display: inline-flex; align-items: center; gap: var(--space-2xs); font-weight: 600; align-self: flex-start; }
  .logo { height: var(--space-md); width: auto; max-width: var(--space-xl); object-fit: contain; }
  .name :global(.dot) { width: var(--space-xs); height: var(--space-xs); border-radius: var(--radius-data); background: var(--color-data); flex: none; }
  .swaps, .chips { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs); }
  .swaps { margin-top: var(--space-2xs); }
  .swaps .chip { border-radius: var(--radius-data); }
  .chips { gap: var(--space-2xs) var(--space-sm); }
  .ch { display: inline-flex; align-items: center; font-size: var(--text-xs); white-space: nowrap; }
  .seg { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .seg input { position: absolute; opacity: 0; width: 0; height: 0; margin: 0; }
  .seg input:checked + .chip { background: var(--color-ink); color: var(--color-paper); }
  .seg input:focus-visible + .chip { outline: calc(var(--space-3xs) / 2) solid var(--color-focus); outline-offset: calc(var(--space-3xs) / 2); }
  [data-bo] { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-sm); }
  .cols span:first-child { text-align: right; }
  .rows { display: flex; flex-direction: column; }
  .hrow { display: grid; grid-template-columns: minmax(0, 7rem) minmax(0, 1fr) auto; gap: var(--space-sm); align-items: baseline; padding: var(--space-2xs) 0; border-top: var(--rule); font-size: var(--text-sm); }
  .hrow:first-child { border-top: 0; }
  .score.win { font-weight: 600; }
  :global(.panel:has(input[value="Bo1"]:checked) [data-bo]:not([data-bo="Bo1"])),
  :global(.panel:has(input[value="Bo3"]:checked) [data-bo]:not([data-bo="Bo3"])),
  :global(.panel:has(input[value="Bo5"]:checked) [data-bo]:not([data-bo="Bo5"])) { display: none; }
  @media (max-width: 640px) {
    .sides { grid-template-columns: minmax(0, 1fr); }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cols span:first-child { text-align: left; }
    .cols span:last-child { text-align: right; }
    .cols span:nth-child(2) { display: none; }
    .hrow { grid-template-columns: minmax(0, 1fr) auto; }
    .hrow .caption { grid-column: 1 / -1; order: 3; }
  }
</style>
