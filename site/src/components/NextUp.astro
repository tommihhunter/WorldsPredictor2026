---
// Series rows. With `hero` (Home) the first series is the page's display moment: the matchup, our pick and its chance in gold.
import Badge from './Badge.astro';
import { pct, nz } from '../lib/format';
import { url } from '../lib/url';
import { HUB, nextUp, resultFor, started } from '../lib/grading';
import { toUtc } from '../lib/stage';
import type { Series } from '../lib/data';
const { rows = nextUp(4), hero = false } = Astro.props as { rows?: Series[]; hero?: boolean };
const split = (s: Series) => (s.bo === 5 ? `3-0 ${pct(s.pw30)}, 3-1 ${pct(s.pw31)}, 3-2 ${pct(s.pw32)}` : '');
const when = (s: Series) => `${nz(s.time_nz, true)} (${s.time_venue || 'venue time TBC'})`;
const flags = (s: Series) => [!resultFor(s) && started(s) && 'In play or awaiting the result', /predicted pairing/.test(s.stage || '') && 'Pairing depends on earlier results'].filter(Boolean).join('. ');
const lead = hero ? rows[0] : undefined;
const rest = hero ? rows.slice(1) : rows;
const lr = lead && resultFor(lead);
---
{rows.length ? (
  <div class="next">
    {lead && (
      <div class:list={['lead', { started: started(lead) }]} data-start={toUtc(lead)}>
        <h1 class="matchup">{lead.team_a} <span class="v">v</span> {lead.team_b}</h1>
        <p class="caption">{lead.stage}. <span class="when">{when(lead)}</span></p>
        <div class="call">
          <span class="pick"><Badge code={lead.winner} /> to win</span>
          <b class="num gold chance">{pct(lead.p_winner)}</b>
          {split(lead) && <span class="num split">{split(lead)}</span>}
          {lr && <span class="result"><span class="num">{lr.winner} {lr.score_a}-{lr.score_b}</span> · <span class={lead.winner === lr.winner ? 'hit' : 'miss'}>{lead.winner === lr.winner ? 'hit' : 'miss'}</span></span>}
        </div>
        {flags(lead) && <p class="caption">{flags(lead)}.</p>}
      </div>
    )}
    {rest.map((s) => {
      const r = resultFor(s);
      return (
        <a class:list={['row', { started: started(s) }]} href={url(HUB[s.phase] ?? '')} data-start={toUtc(s)}>
          <span class="teams"><Badge code={s.team_a} /><span class="caption">v</span><Badge code={s.team_b} /></span>
          <span class="caption meta"><span class="when">{when(s)}</span>{flags(s) && `. ${flags(s)}`}</span>
          <span class="pick">{s.winner} to win{r && <span class="result">, <span class="num">{r.winner} {r.score_a}-{r.score_b}</span> · <span class={s.winner === r.winner ? 'hit' : 'miss'}>{s.winner === r.winner ? 'hit' : 'miss'}</span></span>}</span>
          <span class="num chance">{pct(s.p_winner)}</span>
        </a>
      );
    })}
  </div>
) : <p class="caption">No upcoming predicted series.</p>}
<style>
  .next { display: flex; flex-direction: column; }
  .lead { display: flex; flex-direction: column; gap: var(--space-2xs); padding-bottom: var(--space-md); }
  .matchup .v { color: var(--color-ink-3); font-weight: 500; }
  .call { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs) var(--space-md); margin-top: var(--space-xs); }
  .call .pick { display: inline-flex; align-items: center; gap: var(--space-2xs); color: var(--color-ink-2); }
  .chance { font-size: var(--text-2xl); line-height: 1; }
  .split { font-size: var(--text-sm); color: var(--color-ink-2); }
  .row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto var(--space-xl); grid-template-areas: "teams meta pick chance"; gap: var(--space-3xs) var(--space-md); align-items: center; padding: var(--space-xs) 0; border-top: var(--rule); }
  .row:first-child { border-top: 0; padding-top: 0; }
  .teams { grid-area: teams; display: flex; align-items: center; gap: var(--space-2xs); }
  .meta { grid-area: meta; min-width: 0; }
  .row .pick { grid-area: pick; font-size: var(--text-sm); color: var(--color-ink-2); }
  .row .chance { grid-area: chance; font-size: var(--text-md); text-align: right; }
  @media (max-width: 640px) {
    .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "teams chance" "pick pick" "meta meta"; }
  }
</style>
