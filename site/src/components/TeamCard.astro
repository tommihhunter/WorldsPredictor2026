---
// One tile in the Teams grid: logo and name only (owner's pick, 17/10/2026). Every number lives on the team page.
// data-region and data-rank drive the region filter (teams-grid.js) and tests/check_site.py.
import Logo from './Logo.astro';
import type { Rating } from '../lib/data';
import { displayName, teamSlug } from '../lib/data';
import { url } from '../lib/url';
const { r } = Astro.props as { r: Rating };
---
<a class="card team" href={url(`teams/${teamSlug(r.code)}/`)} data-region={r.region} data-rank={r.rank}>
  <Logo code={r.code} size={112} />
  <span class="code name">{displayName(r.name)}</span>
  <span class="sub">{r.region}</span>
</a>
<style>
  /* logo and name start at the same height in every tile of a row, even when a long name wraps */
  .team { align-items: center; justify-content: flex-start; text-align: center; gap: var(--space-sm); padding: var(--space-xl) var(--space-md) var(--space-lg); }
  .team:hover .name { color: var(--gold); }
  .team:active { border-color: var(--gold); }
  .name { font-size: var(--fs-lg); line-height: var(--lh-tight); text-wrap: balance; transition: color 120ms ease; }
  .sub { font-size: var(--fs-sm); color: var(--muted); }
  @media (max-width: 640px) {
    .team { gap: var(--space-2xs); padding: var(--space-md) var(--space-2xs) var(--space-sm); }
    .team :global(.logo), .team :global(.disc) { --s: 64px !important; }
    .name { font-size: var(--fs-md); }
    .sub { font-size: var(--fs-xs); }
  }
</style>
