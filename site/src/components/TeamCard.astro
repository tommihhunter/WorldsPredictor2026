---
// One team as a hairline tile: logo and name, region and seed, a mono data line, the form word. Numbers only, no bar.
import type { Dossier, Live, Rating } from '../lib/data';
import { teamSlug, REGION_COLOR } from '../lib/data';
import { pct } from '../lib/format';
import { url } from '../lib/url';
const { r, d, lv } = Astro.props as { r: Rating; d: Dossier | undefined; lv: Live | undefined };
const odds = lv?.p_champion ?? r.p_champion;
const ts = d?.team_season;
// Sort keys: a missing stat sorts last (-1e9) rather than breaking the order.
const key = (x: number | null | undefined) => (x == null ? -1e9 : x);
---
<a class="team" href={url(`teams/${teamSlug(r.code)}/`)} style={`--b:${REGION_COLOR[r.region] ?? 'var(--color-data)'}`}
  data-region={r.region} data-tier={r.tier} data-rank={r.rank} data-odds={odds} data-rating={r.elo}
  data-wr={key(ts?.wr)} data-gd15={key(ts?.gd15)} data-blue={key(ts?.blue_wr)} data-pool={key(d?.pool_depth)}>
  <div class="id">
    <img src={url(`art/logos/${r.code}.png`)} alt="" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'dot'}))" />
    <h3>{r.name}</h3>
  </div>
  <span class="caption">{r.region} seed {r.seed}</span>
  <span class="num line">rank {r.rank} · rating {r.elo} · title {pct(odds, 1)}{lv ? '' : ' frozen'}</span>
  <span class="tier">{r.trend || 'UNKNOWN'}</span>
</a>
<style>
  .team { display: flex; flex-direction: column; gap: var(--space-3xs); border-top: var(--rule); padding: var(--space-sm) 0; min-width: 0; }
  .team:hover { color: inherit; }
  .team:hover h3 { color: var(--color-accent); }
  h3 { transition: color var(--dur-short) var(--ease-out); }
  .id { display: flex; align-items: center; gap: var(--space-xs); min-width: 0; }
  .id img { height: var(--space-lg); width: auto; max-width: var(--space-xl); object-fit: contain; flex: none; }
  .id :global(.dot) { width: var(--space-sm); height: var(--space-sm); border-radius: var(--radius-data); background: var(--b); flex: none; }
  .line { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: var(--space-2xs); }
</style>
