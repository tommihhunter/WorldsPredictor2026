---
import Badge from './Badge.astro';
import { pct } from '../lib/format';
const { rows, top = 10 } = Astro.props as { rows: { code: string; p: number }[]; top?: number };
const list = [...rows].sort((a, b) => b.p - a.p).slice(0, top);
const max = list[0]?.p || 1;
---
{list.length ? (
  <ol class="odds">
    {list.map((r, i) => (
      <li><span class="num rank">{i + 1}</span><Badge code={r.code} /><span class="bar"><i class:list={[{ lead: i === 0 }]} style={`width:${((100 * r.p) / max).toFixed(1)}%`}></i></span><span class="num p">{pct(r.p, 1)}</span></li>
    ))}
  </ol>
) : <p class="caption">Live odds not available yet.</p>}
<style>
  .odds { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2xs); }
  .odds li { display: grid; grid-template-columns: var(--space-md) calc(var(--space-2xl) + var(--space-2xs)) minmax(0, 1fr) var(--space-xl); align-items: center; gap: var(--space-xs); }
  .rank { color: var(--color-ink-3); font-size: var(--text-xs); }
  .p { text-align: right; font-size: var(--text-sm); }
</style>
