---
import Badge from './Badge.astro';
import { pct } from '../lib/format';
const { rows, top = 10 } = Astro.props as { rows: { code: string; p: number }[]; top?: number };
const list = [...rows].sort((a, b) => b.p - a.p).slice(0, top);
const max = list[0]?.p || 1;
---
{list.length ? (
  <ol class="odds">
    {list.map((r, i) => (
      <li><span class="cap muted">{i + 1}</span><Badge code={r.code} /><span class="bar"><i class:list={[{ lead: i === 0 }]} style={`width:${((100 * r.p) / max).toFixed(1)}%`}></i></span><b>{pct(r.p, 1)}</b></li>
    ))}
  </ol>
) : <p class="muted cap">Live odds not available yet.</p>}
<style>
  .odds { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px; }
  .odds li { display:grid; grid-template-columns:20px 84px minmax(0,1fr) 52px; align-items:center; gap:10px; }
  .odds b { text-align:right; font-weight:600; }
</style>
