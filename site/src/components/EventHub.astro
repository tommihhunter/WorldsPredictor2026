---
// One hub per stage. The Frozen / Latest toggle is two radios: CSS shows one pre-rendered block, no script needed.
import Card from './Card.astro';
import NextUp from './NextUp.astro';
import Bracket from './Bracket.astro';
import SeriesList from './SeriesList.astro';
import SwissTable from './SwissTable.astro';
import Badge from './Badge.astro';
import { swiss } from '../lib/data';
import { pct, num } from '../lib/format';
import { nzToday } from '../lib/grading';
import { liveStage } from '../lib/nav';
import { url } from '../lib/url';
import { bySchedule, expectations, isToday, latestSet, resultFor, started, stagePickems, swissRecords, view, type Stage } from '../lib/stage';
import type { Series } from '../lib/data';
const { stage: st } = Astro.props as { stage: Stage };
const hasLatest = latestSet() !== null;
const blocks = (hasLatest ? (['baseline', 'latest'] as const) : (['baseline'] as const)).map((w) => ({ which: w, ...view(st, w) }));
const shown = blocks[blocks.length - 1];
const sorted = [...shown.rows].filter((s) => !s.actual).sort(bySchedule);
const todays = sorted.filter(isToday);
const strip = todays.length ? todays : sorted.filter((s) => !resultFor(s)).slice(0, 2);
const picks = stagePickems(st.pickemsStage);
const locked = started({ time_nz: st.lock } as Series);
const records = swissRecords();
const facts: [string, string][] = [['Dates', st.dates], ['Venue', st.venue], ['Format', st.format], ['Draft', st.draft], ["Pick'Ems lock", st.lock]];
---
<div class="hub">
  <header>
    <div class="title"><h1>{st.title}</h1>{liveStage() === st.id && <span class="pill gold">LIVE</span>}</div>
    <dl class="facts">{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    <div class="seg" role="radiogroup" aria-label="Prediction set">
      <input type="radio" name={`set-${st.id}`} id={`${st.id}-baseline`} value="baseline" checked={!hasLatest} />
      <label for={`${st.id}-baseline`}>Frozen baseline</label>
      <input type="radio" name={`set-${st.id}`} id={`${st.id}-latest`} value="latest" checked={hasLatest} disabled={!hasLatest} />
      <label for={`${st.id}-latest`}>{hasLatest ? 'Latest staged' : 'No staged run yet'}</label>
    </div>
    {blocks.map((b) => <p class="cap muted" data-set={b.which}>{b.note}</p>)}
  </header>

  <Card tone="gold">
    <div class="card-head">
      <h3>{todays.length ? 'Today' : 'Next up'}</h3>
      <span class="cap muted">{todays.length ? <><span data-today>{nzToday()}</span>, NZDT</> : `The next open ${st.title} series`}</span>
    </div>
    <NextUp rows={strip} />
  </Card>

  {blocks.map((b) => (
    <div class="block" data-set={b.which}>
      {st.brackets ? (
        <Card title="Bracket" note={st.venue}>
          <p class="cap muted">{st.note}</p>
          {b.stageNote && <p class="cap gold">{b.stageNote}</p>}
          <Bracket cols={st.brackets} rows={b.rows} block={b.which} />
        </Card>
      ) : (
        <Card title="Standings" note="Predicted record and live W-L">
          <p class="cap muted">{st.note}</p>
          {b.stageNote && <p class="cap gold">{b.stageNote}</p>}
          <SwissTable rows={swiss().filter((x) => x.set === b.swissSet)} records={records} />
        </Card>
      )}
      <Card title="Series" note="Tap a series for the reasoning">
        <SeriesList rows={b.rows} block={b.which} phase={st.title} />
      </Card>
    </div>
  ))}

  <Card title="Pick'Ems" note={picks[0]?.status ?? undefined}>
    {picks.length ? (
      <div class="scroll">
        <table>
          <thead><tr><th>Slot</th><th>Pick</th><th class="r">Chance</th><th class="r">Points</th><th>Actual</th><th class="r">Earned</th></tr></thead>
          <tbody>
            {picks.map((p) => (
              <tr>
                <td>{p.slot}</td><td><Badge code={p.pick} /></td><td class="r">{pct(p.p)}</td><td class="r">{p.points ?? 'UNKNOWN'}</td>
                <td>{p.actual ? <span class:list={['pill', p.actual === p.pick ? 'good' : 'bad']}>{p.actual}</span> : <span class="muted">Not played</span>}</td>
                <td class="r">{p.earned ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p class="muted cap">{st.title} picks not available yet.</p>}
  </Card>

  {blocks.map((b) => {
    const x = expectations(b.rows);
    return (
      <div data-set={b.which}>
        <Card title="Expected vs actual" note={x.n ? `${x.act.done} of ${x.n} Bo5s decided` : undefined}>
          {x.n ? (
            <>
              <p class="cap muted">Across these {x.n} series the model expects about {num(x.e30)} sweeps, {num(x.e31)} 3-1s, {num(x.e32)} 3-2s and {num(x.up)} upsets. A sweep is the single most likely score in most matchups, but most series are still expected not to be sweeps. Check against 2026: of 178 Bo5s predicted walk-forward, 44% ended 3-0, 31% 3-1 and 25% 3-2, and 3-0 was the most common result at every favourite strength (model/sweep_check.py).</p>
              <div class="grid-4 tiles">
                {([['3-0', x.e30, x.act['3-0']], ['3-1', x.e31, x.act['3-1']], ['3-2', x.e32, x.act['3-2']], ['Upsets', x.up, x.act.upset]] as const).map(([k, e, a]) => (
                  <div class="card tile"><span class="label">{k}</span><b>{a}</b><span class="cap muted">expected {num(e)}</span></div>
                ))}
              </div>
            </>
          ) : <p class="muted cap">No Bo5 series predicted for this stage yet.</p>}
        </Card>
      </div>
    );
  })}

  <div class="card tile lock">
    <span class="label">Pick'Ems lock</span><b>{st.lock}</b>
    <span class="cap muted">{locked ? 'Locked. Picks above are final.' : 'Still open.'} <a href={url('scorecard/')}>Scorecard</a></span>
  </div>
</div>
<script is:inline src={url('js/clock.js')} defer></script>
<style>
  .hub { display:flex; flex-direction:column; gap:24px; }
  header { display:flex; flex-direction:column; gap:10px; }
  header p { margin:0; }
  .title { display:flex; align-items:center; gap:12px; }
  .facts { display:grid; grid-template-columns:120px minmax(0,1fr); gap:4px 16px; margin:0; font-size:14px; }
  .facts dt { color:var(--muted); font-weight:600; } .facts dd { margin:0; color:var(--fg2); }
  .seg { display:inline-flex; align-self:flex-start; border:1px solid var(--line); border-radius:999px; padding:3px; gap:2px; }
  .seg input { position:absolute; opacity:0; width:1px; height:1px; }
  .seg label { padding:6px 14px; border-radius:999px; font-size:13px; font-weight:600; color:var(--muted); cursor:pointer; }
  .seg input:checked + label { background:var(--gold); color:var(--bg); }
  .seg input:disabled + label { cursor:default; opacity:.6; }
  .seg input:focus-visible + label { outline:2px solid var(--gold); outline-offset:2px; }
  .block { display:flex; flex-direction:column; gap:24px; }
  :global(.hub:has(input[value="baseline"]:checked) [data-set="latest"]), :global(.hub:has(input[value="latest"]:checked) [data-set="baseline"]) { display:none; }
  .tile b { font-size:22px; }
  .lock a { color:var(--gold); font-weight:600; }
  p { margin:0; }
  @media (max-width: 640px) { .facts { grid-template-columns:1fr; gap:0; } .facts dd { margin-bottom:6px; } }
</style>
