---
// One hub per stage. The Frozen / Latest toggle is two chip radios: CSS shows one pre-rendered block, no script needed.
// The display moment is the Today strip's first matchup (NextUp hero) in the page's one panel.
import Card from './Card.astro';
import NextUp from './NextUp.astro';
import Bracket from './Bracket.astro';
import SeriesList from './SeriesList.astro';
import SwissTable from './SwissTable.astro';
import Badge from './Badge.astro';
import { swiss } from '../lib/data';
import { pct, num } from '../lib/format';
import { nzToday } from '../lib/grading';
import { liveStage } from '../lib/nav';
import { url } from '../lib/url';
import { bySchedule, expectations, isToday, latestSet, resultFor, started, stagePickems, swissRecords, view, type Stage } from '../lib/stage';
import type { Series } from '../lib/data';
const { stage: st } = Astro.props as { stage: Stage };
const hasLatest = latestSet() !== null;
const blocks = (hasLatest ? (['baseline', 'latest'] as const) : (['baseline'] as const)).map((w) => ({ which: w, ...view(st, w) }));
const shown = blocks[blocks.length - 1];
const sorted = [...shown.rows].filter((s) => !s.actual).sort(bySchedule);
const todays = sorted.filter(isToday);
const strip = todays.length ? todays : sorted.filter((s) => !resultFor(s)).slice(0, 2);
const picks = stagePickems(st.pickemsStage);
const locked = started({ time_nz: st.lock } as Series);
const records = swissRecords();
// "FINAL - lock ..." -> "Final, lock ..." (the status string is data; only its case and dash change here)
const status = (picks[0]?.status ?? '').replace(/^([A-Z]+) - /, (_, w: string) => `${w[0]}${w.slice(1).toLowerCase()}, `);
---
<div class="hub">
  <header class="page-head">
    <div class="title"><h1>{st.title}</h1>{liveStage() === st.id && <span class="live-tag">LIVE</span>}</div>
    <p class="caption">Played {st.dates} at {st.venue}. {st.format} {st.draft} Pick'Ems lock {st.lock}.</p>
    <div class="seg" role="radiogroup" aria-label="Prediction set">
      <input type="radio" name={`set-${st.id}`} id={`${st.id}-baseline`} value="baseline" checked={!hasLatest} />
      <label class="chip" for={`${st.id}-baseline`}>Frozen baseline</label>
      <input type="radio" name={`set-${st.id}`} id={`${st.id}-latest`} value="latest" checked={hasLatest} disabled={!hasLatest} />
      <label class="chip" for={`${st.id}-latest`}>{hasLatest ? 'Latest staged' : 'No staged run yet'}</label>
    </div>
    {blocks.map((b) => <p class="caption" data-set={b.which}>{b.note}</p>)}
  </header>

  <section class="panel">
    <p class="caption">{todays.length ? <>Today, <span data-today>{nzToday()}</span>, NZDT.</> : `Next up, the next open ${st.title} series.`}</p>
    <NextUp rows={strip} hero />
  </section>

  {blocks.map((b) => (
    <div class="block" data-set={b.which}>
      {st.brackets ? (
        <Card title="Bracket" note={st.venue}>
          <p class="caption">{st.note}</p>
          {b.stageNote && <p class="caption">{b.stageNote}</p>}
          <Bracket cols={st.brackets} rows={b.rows} block={b.which} />
        </Card>
      ) : (
        <Card title="Standings" note="Predicted record and live W-L.">
          <p class="caption">{st.note}</p>
          {b.stageNote && <p class="caption">{b.stageNote}</p>}
          <SwissTable rows={swiss().filter((x) => x.set === b.swissSet)} records={records} />
        </Card>
      )}
      <Card title="Series" note="Tap a series for the reasoning.">
        <SeriesList rows={b.rows} block={b.which} phase={st.title} />
      </Card>
    </div>
  ))}

  <section class="section">
    <div class="section-head">
      <h2>Pick'Ems</h2>
      <span class="caption">{status && `${status}. `}{locked ? 'Locked, the picks below are final.' : 'Still open.'} <a class="more" href={url('scorecard/')}>Scorecard</a></span>
    </div>
    {picks.length ? (
      <div class="scroll">
        <table>
          <thead><tr><th>Slot</th><th>Pick</th><th class="r">Chance</th><th class="r">Points</th><th>Actual</th><th class="r">Earned</th></tr></thead>
          <tbody>
            {picks.map((p) => (
              <tr>
                <td>{p.slot}</td><td><Badge code={p.pick} /></td><td class="num">{pct(p.p)}</td><td class:list={['num', { muted: p.points == null }]}>{p.points ?? 'UNKNOWN'}</td>
                <td class="nw">{p.actual ? <>{p.actual}, <span class={p.actual === p.pick ? 'hit' : 'miss'}>{p.actual === p.pick ? 'hit' : 'miss'}</span></> : <span class="caption">Not played</span>}</td>
                <td class="num">{p.earned ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p class="caption">{st.title} picks not available yet.</p>}
  </section>

  {blocks.map((b) => {
    const x = expectations(b.rows);
    return (
      <div class="block" data-set={b.which}>
        <Card title="Expected vs actual" note={x.n ? `${x.act.done} of ${x.n} Bo5s decided.` : undefined}>
          {x.n ? (
            <>
              <p class="caption">Across these {x.n} series the model expects about {num(x.e30)} sweeps, {num(x.e31)} 3-1s, {num(x.e32)} 3-2s and {num(x.up)} upsets. A sweep is the single most likely score in most matchups, but most series are still expected not to be sweeps. Check against 2026: of 178 Bo5s predicted walk-forward, 44% ended 3-0, 31% 3-1 and 25% 3-2, and 3-0 was the most common result at every favourite strength (model/sweep_check.py).</p>
              <div class="grid-4">
                {([['3-0', x.e30, x.act['3-0']], ['3-1', x.e31, x.act['3-1']], ['3-2', x.e32, x.act['3-2']], ['Upsets', x.up, x.act.upset]] as const).map(([k, e, a]) => (
                  <div class="stat"><b>{a}</b><span>{k}, expected {num(e)}.</span></div>
                ))}
              </div>
            </>
          ) : <p class="caption">No Bo5 series predicted for this stage yet.</p>}
        </Card>
      </div>
    );
  })}
</div>
<script is:inline src={url('js/clock.js')} defer></script>
<style>
  .hub, .block { display: contents; }
  .title { display: flex; align-items: baseline; gap: var(--space-xs); }
  .title h1 { font-size: var(--text-xl); line-height: 1.1; }
  .seg { display: flex; flex-wrap: wrap; gap: var(--space-2xs); margin-top: var(--space-2xs); }
  .seg input { position: absolute; opacity: 0; width: 0; height: 0; margin: 0; }
  .seg input:checked + .chip { background: var(--color-ink); color: var(--color-paper); }
  .seg input:disabled + .chip { cursor: default; opacity: 0.6; }
  .seg input:focus-visible + .chip { outline: calc(var(--space-3xs) / 2) solid var(--color-focus); outline-offset: calc(var(--space-3xs) / 2); }
  .nw { white-space: nowrap; }
  .more { color: var(--color-ink-2); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: var(--space-3xs); }
  :global(.hub:has(input[value="baseline"]:checked) [data-set="latest"]), :global(.hub:has(input[value="latest"]:checked) [data-set="baseline"]) { display: none; }
</style>
